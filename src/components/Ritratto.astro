---
// Spazio per il ritratto di Lorenzo. Forma ad arco: una "porta" aperta.
// Finché non c'è la foto mostra una sagoma segnaposto, chiaramente marcata.
import { contatti } from '../data/sito.js';
interface Props { classe?: string; eager?: boolean; }
const { classe = '', eager = false } = Astro.props;
const foto = contatti.foto;
---
<figure class={`ritratto ${classe}`}>
  {foto ? (
    <img src={foto} alt="Il Dott. Lorenzo Baldassarri, psicologo e psicoterapeuta" width="1200" height="1500" loading={eager ? 'eager' : 'lazy'} decoding="async" />
  ) : (
    <div class="ritratto-vuoto" aria-hidden="true">
      <svg viewBox="0 0 200 250" preserveAspectRatio="xMidYMax meet">
        <defs>
          <linearGradient id="sagoma" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#2A313B" />
            <stop offset="1" stop-color="#1A2028" />
          </linearGradient>
        </defs>
        <circle cx="100" cy="98" r="38" fill="url(#sagoma)" />
        <path d="M22 250 C 26 186, 60 158, 100 158 C 140 158, 174 186, 178 250 Z" fill="url(#sagoma)" />
      </svg>
      <span class="ritratto-etichetta mono">Foto di Lorenzo · 4:5</span>
    </div>
  )}
</figure>
<style>
  .ritratto { position: relative; margin: 0; aspect-ratio: 4 / 5; max-width: 100%; border-radius: 999px 999px 22px 22px; overflow: hidden; isolation: isolate;
    background: radial-gradient(120% 70% at 85% 8%, color-mix(in srgb, var(--terracotta) 38%, transparent), transparent 60%), linear-gradient(160deg, #222932, #0F1419);
    box-shadow: 0 40px 80px -40px rgba(18, 22, 28, .55); }
  .ritratto img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) contrast(1.05); }
  /* luce calda laterale sulla foto in bianco e nero */
  .ritratto::after { content: ''; position: absolute; inset: 0; background: linear-gradient(110deg, transparent 55%, color-mix(in srgb, var(--terracotta) 22%, transparent)); mix-blend-mode: soft-light; pointer-events: none; }
  .ritratto-vuoto { position: absolute; inset: 0; display: grid; }
  .ritratto-vuoto svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .ritratto-etichetta { position: absolute; left: 50%; bottom: 1.1rem; transform: translateX(-50%); white-space: nowrap; font-size: .62rem; letter-spacing: .14em; text-transform: uppercase; color: #F6F2EA; opacity: .75; padding: .35rem .7rem; border: 1px dashed rgba(246, 242, 234, .4); border-radius: 999px; }
</style>
