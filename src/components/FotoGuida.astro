---
// Spazio foto con guida allo scatto.
// Se `src` è valorizzato mostra la foto vera; altrimenti una scena illustrata a colori
// con le istruzioni per scattarla (inquadratura, luce, sguardo).
interface Props {
  tipo: 'ritratto' | 'studio' | 'campo' | 'box' | 'palco';
  src?: string | null;
  alt?: string;
  titolo?: string;
  guida?: string[];
  classe?: string;
  eager?: boolean;
  fuoco?: string;
}
const { tipo, src = null, alt = '', titolo = 'Foto da scattare', guida = [], classe = '', eager = false, fuoco = '50% 35%' } = Astro.props;
const verticale = tipo === 'ritratto' || tipo === 'studio';
const id = `fg-${tipo}`;
---
<figure class={`foto-guida ${verticale ? 'v' : 'h'} ${classe}`}>
  {src ? (
    <picture>
      <source srcset={src.replace(/\.jpe?g$/, '.webp')} type="image/webp" />
      <img src={src} alt={alt} width="512" height="512" style={`object-position:${fuoco}`} loading={eager ? 'eager' : 'lazy'} decoding="async" />
    </picture>
  ) : (
    <>
      <svg class="scena" viewBox={verticale ? '0 0 400 500' : '0 0 600 400'} preserveAspectRatio="xMidYMid slice" aria-hidden="true">
        <defs>
          <linearGradient id={`${id}-cielo`} x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color={tipo === 'campo' ? '#3E5A70' : tipo === 'box' ? '#141C42' : tipo === 'palco' ? '#0B1230' : '#DCE3F5'} />
            <stop offset="1" stop-color={tipo === 'campo' ? '#6C879A' : tipo === 'box' ? '#2B3F8F' : tipo === 'palco' ? '#2B3F8F' : '#A9B8E8'} />
          </linearGradient>
          <linearGradient id={`${id}-figura`} x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#1D2440" />
            <stop offset="1" stop-color="#0B1230" />
          </linearGradient>
          <radialGradient id={`${id}-luce`} cx=".85" cy=".15" r=".8">
            <stop offset="0" stop-color="#FFFFFF" stop-opacity=".35" />
            <stop offset="1" stop-color="#FFFFFF" stop-opacity="0" />
          </radialGradient>
        </defs>
        <rect width="100%" height="100%" fill={`url(#${id}-cielo)`} />
        <rect width="100%" height="100%" fill={`url(#${id}-luce)`} />
        {tipo === 'ritratto' && (
          <g fill={`url(#${id}-figura)`}>
            <circle cx="180" cy="200" r="70" />
            <path d="M40 500 C 48 380, 110 318, 180 318 C 250 318, 312 380, 320 500 Z" />
          </g>
        )}
        {tipo === 'studio' && (
          <g>
            <rect x="250" y="40" width="120" height="170" rx="6" fill="#FAF8F4" opacity=".35" />
            <rect x="60" y="360" width="280" height="14" rx="7" fill="#0B1230" opacity=".35" />
            <g fill={`url(#${id}-figura)`}>
              <circle cx="170" cy="190" r="52" />
              <path d="M70 500 C 74 380, 116 286, 170 286 C 224 286, 266 380, 270 500 Z" />
            </g>
          </g>
        )}
        {tipo === 'campo' && (
          <g>
            <g stroke="#FAF8F4" stroke-opacity=".55" stroke-width="3" fill="none">
              <line x1="0" y1="300" x2="600" y2="300" />
              <circle cx="300" cy="300" r="70" />
              <line x1="300" y1="230" x2="300" y2="400" />
            </g>
            <g fill={`url(#${id}-figura)`}>
              <circle cx="190" cy="150" r="26" /><path d="M150 330 C 152 230, 168 188, 190 188 C 212 188, 228 230, 230 330 Z" />
              <circle cx="400" cy="170" r="22" /><path d="M366 330 C 368 246, 382 206, 400 206 C 418 206, 432 246, 434 330 Z" />
            </g>
            <circle cx="320" cy="318" r="12" fill="#FAF8F4" />
          </g>
        )}
        {tipo === 'box' && (
          <g>
            <path d="M0 320 L 330 300 C 400 296, 470 280, 600 250 L 600 400 L 0 400 Z" fill="#C9D3FF" fill-opacity=".35" />
            <path d="M80 318 L 300 304" stroke="#FAF8F4" stroke-width="6" stroke-opacity=".6" />
            <g fill={`url(#${id}-figura)`}>
              <circle cx="420" cy="120" r="30" /><path d="M374 300 C 376 200, 396 156, 420 156 C 444 156, 464 200, 466 300 Z" />
            </g>
            <circle cx="170" cy="250" r="34" fill="#FAF8F4" /><rect x="140" y="246" width="60" height="10" rx="5" fill="#0B1230" />
          </g>
        )}
        {tipo === 'palco' && (
          <g>
            <rect x="250" y="50" width="300" height="180" rx="10" fill="#FAF8F4" opacity=".14" />
            <path d="M270 190 L 330 150 L 380 170 L 440 100 L 520 120" stroke="#FAF8F4" stroke-width="5" fill="none" stroke-linecap="round" stroke-linejoin="round" />
            <rect x="110" y="270" width="120" height="130" rx="8" fill="#C9D3FF" fill-opacity=".5" />
            <g fill={`url(#${id}-figura)`}>
              <circle cx="170" cy="170" r="30" /><path d="M126 280 C 128 228, 146 206, 170 206 C 194 206, 212 228, 214 280 Z" />
            </g>
          </g>
        )}
      </svg>
      <figcaption class="guida">
        <span class="guida-titolo mono">{titolo}</span>
        {guida.length > 0 && <ul role="list">{guida.map((g) => <li>{g}</li>)}</ul>}
      </figcaption>
    </>
  )}
</figure>

<style>
  .foto-guida { position: relative; margin: 0; overflow: hidden; border-radius: var(--radius); isolation: isolate; max-width: 100%; background: var(--cruscotto); }
  .foto-guida.v { aspect-ratio: 4 / 5; }
  .foto-guida.h { aspect-ratio: 3 / 2; }
  .foto-guida img, .scena { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .guida {
    position: absolute; left: .75rem; right: .75rem; bottom: .75rem; display: grid; gap: .35rem;
    padding: .7rem .85rem; border-radius: 14px; color: var(--testo-scuro);
    background: color-mix(in srgb, var(--cruscotto) 72%, transparent); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
    border: 1px dashed rgba(241, 238, 230, .35); font-size: .8rem; line-height: 1.35;
  }
  .guida-titolo { font-size: .62rem; letter-spacing: .16em; text-transform: uppercase; color: #C9D3FF; }
  .guida ul { display: grid; gap: .15rem; margin: 0; padding: 0; list-style: none; }
  .guida li::before { content: '· '; color: #C9D3FF; }
</style>
