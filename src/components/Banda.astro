---
// Banda di chiusura con una sola azione principale
interface Props { titolo?: string; testo?: string; tema?: 'carta' | 'cruscotto'; }
const { titolo = 'Il primo passo è una chiacchierata.', testo = '20 minuti al telefono o in video: mi racconti cosa ti succede, io ti dico se e come posso aiutarti.', tema = 'cruscotto' } = Astro.props;
---
<section class="sezione banda" data-theme={tema}>
  <div class="wrap banda-grid">
    <h2 data-reveal>{titolo}</h2>
    <div class="banda-dx" data-reveal>
      <p class="lead">{testo}</p>
      <a class="btn btn-primario" href="/contatti" data-cta>Prenota il primo colloquio</a>
    </div>
  </div>
</section>
<style>
  .banda-grid { display: grid; grid-template-columns: 1.2fr 1fr; gap: 2rem; align-items: end; }
  .banda h2 { font-size: clamp(2.6rem, 1.6rem + 5vw, 6rem); }
  .banda-dx { display: grid; gap: 1.5rem; justify-items: start; }
  @media (max-width: 820px) { .banda-grid { grid-template-columns: 1fr; } }
</style>
