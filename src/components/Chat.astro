---
// Chat di contatto: pallino fisso in basso a destra con il volto di Lorenzo.
// Due strade: messaggio su WhatsApp, oppure richiesta guidata per farsi ricontattare.
import { contatti } from '../data/sito.js';
const volto = contatti.volto;
const voltoWebp = volto.replace(/\.jpe?g$/, '.webp');
---
<div class="chat" data-chat data-wa={contatti.whatsapp}>
  <section class="chat-pannello" id="chat-pannello" role="dialog" aria-modal="false" aria-labelledby="chat-titolo" hidden>
    <header class="chat-testa">
      <picture>
        <source srcset={voltoWebp} type="image/webp" />
        <img class="chat-volto" src={volto} alt="" width="48" height="48" />
      </picture>
      <div class="chat-chi">
        <p id="chat-titolo" class="chat-nome">Dott. Lorenzo Baldassarri</p>
        <p class="chat-ruolo">Psicologo esperto di performance</p>
      </div>
      <button type="button" class="chat-chiudi" data-chat-chiudi aria-label="Chiudi la chat">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
      </button>
    </header>

    <div class="chat-corpo" data-chat-corpo aria-live="polite">
      <!-- i messaggi vengono aggiunti dallo script -->
    </div>

    <div class="chat-azioni" data-chat-azioni></div>
    <p class="chat-nota">Non inserire informazioni sulla tua salute: ne parleremo di persona. In caso di emergenza chiama il 112.</p>
  </section>

  <button type="button" class="chat-bolla" data-chat-apri aria-expanded="false" aria-controls="chat-pannello" aria-label="Contatta Lorenzo: prenota una call o scrivi su WhatsApp">
    <picture>
      <source srcset={voltoWebp} type="image/webp" />
      <img src={volto} alt="" width="64" height="64" />
    </picture>
    <span class="chat-badge" aria-hidden="true">
      <svg viewBox="0 0 24 24"><path d="M4 5h16v11H9l-5 4z" /></svg>
    </span>
  </button>
  <p class="chat-invito" data-chat-invito hidden>Prenota una call con me</p>
</div>

<style is:global>
  .chat { position: fixed; right: max(1rem, env(safe-area-inset-right, 0px)); bottom: max(1rem, env(safe-area-inset-bottom, 0px)); z-index: 60; font-family: var(--f-text); }
  .chat-bolla {
    position: relative; width: 4rem; height: 4rem; border-radius: 50%; padding: 0; border: 3px solid #fff; background: var(--inchiostro);
    box-shadow: 0 14px 34px -12px rgba(11, 18, 48, .55); cursor: pointer; display: block; margin-left: auto;
    transition: transform .4s var(--respiro);
  }
  .chat-bolla:hover { transform: scale(1.06); }
  .chat-bolla img { width: 100%; height: 100%; border-radius: 50%; object-fit: cover; display: block; }
  .chat-bolla::after { content: ''; position: absolute; inset: -6px; border-radius: 50%; border: 2px solid var(--terracotta); opacity: 0; animation: chat-onda 3.2s var(--respiro) 2s 3; }
  @keyframes chat-onda { 0% { opacity: .7; transform: scale(.92); } 100% { opacity: 0; transform: scale(1.25); } }
  .chat-badge { position: absolute; right: -4px; bottom: -4px; width: 1.6rem; height: 1.6rem; border-radius: 50%; background: var(--terracotta); border: 2px solid #fff; display: grid; place-items: center; }
  .chat-badge svg { width: .85rem; height: .85rem; fill: #fff; }
  .chat-aperta .chat-badge { display: none; }
  .chat-invito {
    position: absolute; right: 4.6rem; bottom: .9rem; margin: 0; white-space: nowrap; padding: .55rem .9rem; border-radius: 16px 16px 4px 16px;
    background: #fff; color: var(--inchiostro); font-size: .9rem; font-weight: 500; box-shadow: 0 12px 30px -14px rgba(11, 18, 48, .45);
    animation: chat-entra .6s var(--uscita);
  }

  .chat-pannello {
    position: absolute; right: 0; bottom: 5rem; width: min(380px, calc(100vw - 2rem)); height: min(640px, calc(100svh - 6.5rem));
    display: grid; grid-template-rows: auto 1fr auto auto; overflow: hidden; border-radius: 24px; background: #fff; color: var(--inchiostro);
    box-shadow: 0 30px 80px -30px rgba(11, 18, 48, .6); border: 1px solid rgba(18, 22, 28, .08);
    transform-origin: bottom right; animation: chat-entra .45s var(--uscita);
  }
  @keyframes chat-entra { from { opacity: 0; transform: translateY(10px) scale(.97); } to { opacity: 1; transform: none; } }
  .chat-testa { display: flex; align-items: center; gap: .75rem; padding: .9rem 1rem; background: var(--cruscotto); color: var(--testo-scuro); }
  .chat-volto { width: 3rem; height: 3rem; border-radius: 50%; object-fit: cover; border: 2px solid rgba(255, 255, 255, .5); display: block; }
  .chat-chi { flex: 1; min-width: 0; }
  .chat-nome { margin: 0; font-family: var(--f-display); font-weight: 700; letter-spacing: -0.02em; }
  .chat-ruolo { margin: 0; font-size: .75rem; opacity: .7; }
  .chat-chiudi { width: 2.4rem; height: 2.4rem; border-radius: 50%; border: 0; background: rgba(255, 255, 255, .1); color: inherit; display: grid; place-items: center; cursor: pointer; }
  .chat-chiudi svg { width: 1.1rem; height: 1.1rem; stroke: currentColor; stroke-width: 2; stroke-linecap: round; fill: none; }

  .chat-corpo { overflow-y: auto; padding: 1rem; display: grid; align-content: start; gap: .5rem; background: #F4F3F0; overscroll-behavior: contain; }
  .msg { max-width: 85%; padding: .6rem .85rem; border-radius: 16px; font-size: .92rem; line-height: 1.4; animation: chat-entra .35s var(--uscita); }
  .msg-lui { background: #fff; border-bottom-left-radius: 4px; justify-self: start; box-shadow: 0 1px 2px rgba(0, 0, 0, .06); }
  .msg-tu { background: var(--terracotta); color: #fff; border-bottom-right-radius: 4px; justify-self: end; }
  .msg-riepilogo { justify-self: stretch; max-width: none; background: #fff; border: 1px dashed rgba(18, 22, 28, .2); }
  .msg-riepilogo dl { display: grid; grid-template-columns: auto 1fr; gap: .25rem .75rem; margin: .4rem 0 0; font-size: .85rem; }
  .msg-riepilogo dt { color: var(--grafite); }
  .msg-riepilogo dd { margin: 0; font-weight: 500; overflow-wrap: anywhere; }
  .msg-scrive { display: inline-flex; gap: 4px; }
  .msg-scrive span { width: 6px; height: 6px; border-radius: 50%; background: var(--grafite); opacity: .5; animation: chat-punti 1s infinite; }
  .msg-scrive span:nth-child(2) { animation-delay: .15s; } .msg-scrive span:nth-child(3) { animation-delay: .3s; }
  @keyframes chat-punti { 50% { opacity: 1; transform: translateY(-2px); } }

  .chat-azioni { display: grid; gap: .5rem; padding: .75rem 1rem 0; }
  .chat-azioni:empty { display: none; }
  .scelte { display: flex; flex-wrap: wrap; gap: .4rem; }
  .scelta { border: 1px solid rgba(36, 67, 214, .35); background: #fff; color: var(--terracotta); border-radius: 999px; padding: .5rem .85rem; font-size: .88rem; font-weight: 600; cursor: pointer; min-height: 40px; }
  .scelta:hover { background: rgba(36, 67, 214, .07); }
  .grande { display: flex; align-items: center; gap: .75rem; width: 100%; text-align: left; border: 0; border-radius: 16px; padding: .85rem 1rem; cursor: pointer; font-weight: 600; font-size: .95rem; }
  .grande small { display: block; font-weight: 400; font-size: .78rem; opacity: .8; }
  .grande svg { width: 1.5rem; height: 1.5rem; flex: none; }
  .grande-wa { background: #1F8A55; color: #fff; text-decoration: none; }
  .grande-wa svg { fill: #fff; }
  .grande-call { background: var(--terracotta); color: #fff; }
  .grande-call svg { fill: none; stroke: #fff; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .chat-tel { justify-self: center; font-size: .85rem; font-weight: 600; color: var(--inchiostro); padding: .2rem 0; }
  .chat-campo { display: flex; gap: .4rem; }
  .chat-campo input, .chat-campo textarea { flex: 1; min-width: 0; border: 1px solid rgba(18, 22, 28, .18); border-radius: 14px; padding: .65rem .8rem; font: inherit; font-size: .95rem; background: #fff; color: var(--inchiostro); resize: none; }
  .chat-campo input:focus, .chat-campo textarea:focus { outline: none; border-color: var(--terracotta); box-shadow: 0 0 0 3px rgba(36, 67, 214, .18); }
  .invia { flex: none; width: 2.75rem; border: 0; border-radius: 14px; background: var(--terracotta); color: #fff; cursor: pointer; display: grid; place-items: center; }
  .invia svg { width: 1.1rem; height: 1.1rem; fill: currentColor; }
  .salta { justify-self: start; border: 0; background: none; color: var(--grafite); font-size: .82rem; text-decoration: underline; cursor: pointer; padding: .25rem 0; }
  .chat-consenso { display: flex; gap: .5rem; align-items: flex-start; font-size: .8rem; color: var(--grafite); }
  .chat-consenso input { width: 18px; height: 18px; margin-top: .1rem; accent-color: var(--terracotta); flex: none; }
  .chat-errore { margin: 0; font-size: .8rem; color: #C8322F; }
  .chat-nota { margin: 0; padding: .6rem 1rem .85rem; font-size: .7rem; line-height: 1.35; color: var(--grafite); }

  .chat-azioni .grande { padding: .7rem 1rem; }
  @media (max-width: 480px) {
    .chat-pannello { position: fixed; left: .5rem; right: .5rem; bottom: calc(5.4rem + env(safe-area-inset-bottom, 0px)); width: auto; height: auto; max-height: calc(100svh - 7rem); }
    .chat-invito { font-size: .82rem; padding: .45rem .75rem; bottom: 1.1rem; }
  }
  @media (prefers-reduced-motion: reduce) { .chat-bolla::after { animation: none; } }
</style>
