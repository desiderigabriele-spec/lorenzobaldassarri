---
import '@fontsource-variable/sora';
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import { contatti, porte } from '../data/sito.js';

interface Props {
  title: string;
  description: string;
  path?: string;
  headerOn?: 'carta' | 'cruscotto';
  jsonLd?: Record<string, unknown> | null;
}

const { title, description, path = '/', headerOn = 'carta', jsonLd = null } = Astro.props;
const canonical = new URL(path, Astro.site).toString();
const current = Astro.url.pathname.replace(/\.html$/, '');
const isCurrent = (href: string) => (current === href ? 'page' : undefined);
---
<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#F6F2EA" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <script is:inline>document.documentElement.classList.add('js');</script>
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip-link" href="#contenuto">Vai al contenuto</a>

    <header class="site-header" data-on={headerOn}>
      <div class="wrap header-row">
        <a class="brand" href="/" aria-label="Lorenzo Baldassarri, psicologo e psicoterapeuta: home">
          <span class="brand-nome">Lorenzo Baldassarri</span>
          <span class="brand-ruolo">Psicologo · Psicoterapeuta</span>
        </a>
        <nav class="nav" aria-label="Principale">
          <a href="/metodo" aria-current={isCurrent('/metodo')}>Metodo</a>
          <a href="/psicologo-dello-sport" aria-current={isCurrent('/psicologo-dello-sport')}>Atleti</a>
          <a href="/squadre-e-societa" aria-current={isCurrent('/squadre-e-societa')}>Squadre</a>
          <a href="/aziende-e-leader" aria-current={isCurrent('/aziende-e-leader')}>Aziende</a>
          <a href="/motorsport" aria-current={isCurrent('/motorsport')}>Motorsport</a>
          <a href="/psicoterapia" aria-current={isCurrent('/psicoterapia')}>Psicoterapia</a>
          <a class="btn btn-primario btn-piccolo" href="/contatti" data-cta>Prenota una call</a>
        </nav>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="menu-mobile">
          <span></span><span></span><span class="sr-only">Menu</span>
        </button>
      </div>
    </header>

    <div class="menu-mobile" id="menu-mobile" aria-label="Menu" inert>
      <ul role="list">
        <li><a href="/metodo">Metodo</a></li>
        {porte.map((p) => <li><a href={p.href}>{p.menu}</a></li>)}
        <li><a href="/chi-sono">Chi sono</a></li>
        <li><a href="/contatti">Contatti</a></li>
      </ul>
      <div>
        <p class="mono">Montecatini Terme · online</p>
        <a class="btn btn-primario" href="/contatti" data-cta style="margin-top:1rem;width:100%">Prenota una call</a>
      </div>
    </div>

    <main id="contenuto">
      <slot />
    </main>

    <footer class="site-footer" data-theme="cruscotto">
      <div class="wrap">
        <div class="footer-grid">
          <div>
            <p class="footer-claim">Sotto pressione, la mente si allena.</p>
            <a class="btn btn-primario" href="/contatti" data-cta style="margin-top:2rem;background:var(--segnale);color:var(--cruscotto)">Prenota una call</a>
          </div>
          <div>
            <h2>Per chi lavoro</h2>
            <ul role="list">
              {porte.map((p) => <li><a href={p.href}>{p.menu}</a></li>)}
            </ul>
          </div>
          <div>
            <h2>Studio</h2>
            <ul role="list">
              <li>{contatti.indirizzo}</li>
              <li>{contatti.citta}</li>
              <li>In studio e online</li>
              <li><a href="/chi-sono">Chi sono</a></li>
              <li><a href="/metodo">Il metodo</a></li>
              <li><a href="/contatti">Contatti</a></li>
            </ul>
          </div>
        </div>
        <div class="footer-legale">
          <span>Dott. Lorenzo Baldassarri · Psicologo-Psicoterapeuta · Ordine degli Psicologi della Toscana n. {contatti.albo} · P.IVA {contatti.piva}</span>
          <span><a href="/note-legali">Note legali</a> · <a href="/privacy">Privacy</a> · <a href="/cookie">Cookie</a></span>
        </div>
        <p class="mono" style="margin-top:1rem;font-size:.7rem;opacity:.7">Contenuti informativi: non sostituiscono un colloquio professionale. In caso di emergenza chiama il 112.</p>
      </div>
    </footer>

    <div class="cta-bar" aria-hidden="true">
      <a class="btn btn-primario" href="/contatti" data-cta tabindex="-1">Prenota una call</a>
    </div>

    <script>
      import '../scripts/site.js';
    </script>
  </body>
</html>
