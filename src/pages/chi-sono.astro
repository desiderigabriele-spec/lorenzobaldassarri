---
import Base from '../layouts/Base.astro';
import Banda from '../components/Banda.astro';
import { contatti } from '../data/sito.js';

const formazione = [
  { t: 'Laurea in Psicologia clinica e di comunità', e: 'Università degli Studi di Firenze' },
  { t: 'Laurea specialistica in Psicologia clinica', e: 'Università degli Studi di Urbino Carlo Bo' },
  { t: 'Specializzazione in psicoterapia funzionale-corporea', e: 'SEF · 2010–2014' },
  { t: 'Master in Psicologia e coaching dello sport', e: 'CISSPAT, Padova' },
  { t: 'Master in Psicologia giuridica e forense', e: 'Centro Formazione MeMe, Firenze' },
];
const ruoli = [
  { q: '2011 →', t: 'Psicologo-psicoterapeuta, studio privato', e: 'Montecatini Terme' },
  { q: '2013–2016', t: 'Psicologo dello sport, responsabile area mental', e: 'Formula Medicine, Viareggio' },
  { q: '2017 →', t: 'Docente', e: 'Università degli Studi di Parma' },
  { q: '2017 →', t: 'Co-fondatore', e: 'Gruppo Eljos – Equipe di Psicologia Funzionale' },
  { q: '2021 →', t: 'Co-fondatore', e: 'MindUP Enhancement Psychology®' },
];
---
<Base title="Chi sono — Lorenzo Baldassarri, psicologo e psicoterapeuta" description="Dalla Scuola Calcio alla Formula 1: la storia, la formazione e gli incarichi del Dott. Lorenzo Baldassarri, psicologo-psicoterapeuta e psicologo dello sport." path="/chi-sono">
  <section class="sezione page-hero" data-theme="carta">
    <div class="wrap hero-chi">
      <div>
        <p class="eyebrow" data-reveal>Chi sono</p>
        <h1 data-reveal style="--d:.08s">Prima il campo. Poi la pista.</h1>
        <p class="lead" data-reveal style="--d:.16s">Ho giocato a calcio per oltre vent'anni. Poi ho allenato bambini. Poi sono entrato nel paddock della Formula 1. Ho sempre fatto la stessa cosa: aiutare le persone a rendere sotto pressione, senza perdersi.</p>
      </div>
      <figure class="ritratto" data-reveal>
        <div class="ritratto-foto" role="img" aria-label="Monogramma LB"><span>LB</span></div>
        <figcaption class="mono">Dott. Lorenzo Baldassarri · Montecatini Terme</figcaption>
      </figure>
    </div>
  </section>

  <section class="sezione" data-theme="carta">
    <div class="wrap duo">
      <div>
        <p class="eyebrow" data-reveal>Percorso</p>
        <h2 data-reveal>Incarichi.</h2>
        <ul class="righe" role="list">
          {ruoli.map((r) => <li data-reveal><span class="mono">{r.q}</span><span><strong>{r.t}</strong><br /><span class="muted">{r.e}</span></span></li>)}
        </ul>
      </div>
      <div>
        <p class="eyebrow" data-reveal>Studi</p>
        <h2 data-reveal>Formazione.</h2>
        <ul class="righe" role="list">
          {formazione.map((f, i) => <li data-reveal><span class="mono">0{i + 1}</span><span><strong>{f.t}</strong><br /><span class="muted">{f.e}</span></span></li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="sezione" data-theme="cruscotto">
    <div class="wrap omonimo">
      <p class="eyebrow" data-reveal>Una precisazione</p>
      <p class="h2" data-reveal>Sì, c'è un pilota con il mio nome. No, non sono io.<br /><span class="accento">Ma con i piloti ci lavoro.</span></p>
    </div>
  </section>

  <section class="sezione" data-theme="carta">
    <div class="wrap">
      <p class="mono muted legale">Ordine degli Psicologi della Toscana n. {contatti.albo} · Psicologi referenti dell'academy toscana della Federazione Italiana Rugby (con CISSPAT LAB)</p>
    </div>
  </section>

  <Banda />
</Base>

<style>
  .hero-chi { display: grid; grid-template-columns: 1.3fr 1fr; gap: clamp(2rem, 6vw, 5rem); align-items: end; }
  .page-hero h1 { max-width: 12ch; margin-top: 1.5rem; }
  .page-hero .lead { max-width: 44ch; }
  .ritratto { display: grid; gap: .75rem; margin: 0; }
  .ritratto-foto { aspect-ratio: 4/5; border-radius: var(--radius); background: radial-gradient(120% 80% at 80% 10%, color-mix(in srgb, var(--terracotta) 35%, transparent), transparent 55%), var(--inchiostro); display: grid; place-items: center; overflow: hidden; }
  .ritratto-foto span { font-family: var(--f-display); font-weight: 600; font-size: clamp(4rem, 10vw, 7rem); letter-spacing: -0.06em; color: var(--carta); opacity: .9; }
  .ritratto figcaption { font-size: .7rem; letter-spacing: .1em; color: var(--fg-2); text-transform: uppercase; }
  .duo { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(3rem, 7vw, 6rem); }
  .duo h2 { margin: 1rem 0 2rem; }
  .righe { display: grid; border-top: 1px solid var(--line); }
  .righe li { display: grid; grid-template-columns: 6.5rem 1fr; gap: 1rem; padding: 1.1rem 0; border-bottom: 1px solid var(--line); }
  .righe .mono { font-size: .75rem; color: var(--fg-2); padding-top: .2rem; }
  .righe strong { font-family: var(--f-display); font-weight: 600; letter-spacing: -0.01em; }
  .omonimo { display: grid; gap: 1.5rem; }
  .omonimo .h2 { max-width: 20ch; font-family: var(--f-display); font-weight: 600; letter-spacing: -0.03em; line-height: 1.05; }
  .accento { color: var(--segnale); }
  .legale { font-size: .75rem; letter-spacing: .04em; }
  @media (max-width: 820px) { .hero-chi, .duo { grid-template-columns: 1fr; } .ritratto { max-width: 320px; } }
</style>
