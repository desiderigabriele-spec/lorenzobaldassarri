  @media (max-width: 820px) {
    .chiusura-grid { grid-template-columns: 1fr; }
    .chiusura-ancora { width: min(70vw, 320px); }
  }

  /* ---------- PC: ogni sezione entra nello schermo ---------- */
  @media (min-width: 1024px) {
    .hero { padding-top: max(6rem, 13vh); padding-bottom: 5vh; min-height: 100svh; display: grid; align-content: center; }
    .hero-testo { gap: clamp(.7rem, 1.8vh, 1.2rem); }
    .fiducia { display: none; }
    .hero-foto { width: min(440px, 58vh); }
    .piani-pill { margin-top: -.2rem; }

    .mente { min-height: 100svh; display: grid; align-content: center; }
    .mente-ancora { width: min(520px, 45vh); }
    .mente-legenda { gap: clamp(.6rem, 2vh, 1.4rem); }
    .legenda { gap: 0; }
    .legenda li { padding: clamp(.35rem, 1.1vh, .7rem) 0; }
    .mente-sintesi { font-size: min(clamp(1.2rem, 1rem + .8vw, 1.6rem), 3.2vh); }
    .tel-svg { height: min(70px, 7vh); }
    .mente-stage { gap: clamp(1rem, 2.4vh, 1.75rem); }
    .mente-grid { row-gap: clamp(1.25rem, 3vh, 2.25rem); }

    .porta { min-height: min(13rem, 23vh); gap: 1rem; }

    .respiro { min-height: 100svh; display: grid; align-content: center; }
    .respiro-stage { width: min(520px, 60vh); }

    .cruscotto { min-height: 100svh; display: grid; align-content: center; }

    .campo-sezione .sezione-head { max-width: none; grid-template-columns: 1fr 1fr; align-items: end; column-gap: 3rem; }
    .campo-sezione .sezione-head .eyebrow { grid-column: 1 / -1; }
    .galleria { grid-template-columns: repeat(4, 1fr); grid-template-rows: none; grid-auto-rows: min(440px, 50vh); }
    .galleria :global(.foto-guida) { aspect-ratio: auto !important; height: 100%; grid-row: auto !important; grid-column: auto !important; }

    .chiusura { min-height: auto; }
