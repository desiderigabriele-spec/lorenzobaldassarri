  }

  /* ---------- Guide animate: far capire subito cosa fare ---------- */
  .evidenziatore { background: linear-gradient(transparent 58%, rgba(36, 67, 214, .22) 58%) no-repeat 0 0 / 0% 100%; transition: background-size 1.1s var(--uscita) .3s; }
  .e2 { transition-delay: 1.1s; }
  .mente.vista .evidenziatore { background-size: 100% 100%; }

  .gesto { position: absolute; left: 50%; top: 50%; width: 0; height: 0; z-index: 3; pointer-events: none; transition: opacity .6s var(--respiro); }
  .mente.provato .gesto { opacity: 0; }
  .gesto-cursore { position: absolute; left: -12px; top: -12px; width: 28px; height: 28px; max-width: none; fill: var(--inchiostro); stroke: #fff; stroke-width: 1.5; filter: drop-shadow(0 4px 8px rgba(11, 18, 48, .3)); animation: gesto-muovi 4.2s var(--respiro) infinite; }
  .gesto-scia { position: absolute; left: -70px; top: 2px; width: 140px; height: 3px; border-radius: 3px; background: linear-gradient(90deg, transparent, rgba(36, 67, 214, .55), transparent); animation: gesto-scia 4.2s linear infinite; }
  .gesto-anello { position: absolute; left: -22px; top: -22px; width: 44px; height: 44px; border-radius: 50%; border: 2px solid var(--terracotta); opacity: 0; animation: gesto-anello 4.2s var(--uscita) infinite; }
  .gesto-label { position: absolute; left: 50%; top: 34px; transform: translateX(-50%); white-space: nowrap; font-family: var(--f-display); font-weight: 700; font-size: .9rem; }
  .gesto-label span { position: absolute; left: 50%; transform: translateX(-50%); padding: .35rem .75rem; border-radius: 999px; background: var(--inchiostro); color: #fff; box-shadow: 0 10px 24px -12px rgba(11, 18, 48, .6); }
  .gesto-label .l1 { animation: gesto-l1 4.2s steps(1) infinite; }
  .gesto-label .l2 { background: var(--terracotta); animation: gesto-l2 4.2s steps(1) infinite; }
  @keyframes gesto-muovi {
    0% { transform: translate(-90px, 0); } 8% { transform: translate(90px, -14px); } 16% { transform: translate(-90px, 10px); }
    24% { transform: translate(90px, -8px); } 32% { transform: translate(-90px, 6px); } 40% { transform: translate(60px, 0); }
    50%, 100% { transform: translate(0, 0); }
  }
  @keyframes gesto-scia { 0%, 40% { opacity: 1; transform: scaleX(1); } 48%, 100% { opacity: 0; transform: scaleX(.2); } }
  @keyframes gesto-anello { 0%, 52% { opacity: 0; transform: scale(.6); } 60% { opacity: 1; transform: scale(1); } 85%, 100% { opacity: 0; transform: scale(1.8); } }
  @keyframes gesto-l1 { 0% { opacity: 1; } 48% { opacity: 0; } }
  @keyframes gesto-l2 { 0% { opacity: 0; } 48% { opacity: 1; } }
  @media (pointer: coarse) { .gesto { display: none; } }

  .tieni-dito { position: absolute; left: 1.1rem; top: 50%; width: 1.9rem; height: 1.9rem; margin-top: -.95rem; }
  .tieni-dito svg { width: 100%; height: 100%; fill: none; stroke: #fff; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; animation: dito-preme 1.8s var(--respiro) infinite; transform-origin: 50% 80%; }
  @keyframes dito-preme { 0%, 100% { transform: translateY(0) scale(1); } 40%, 60% { transform: translateY(3px) scale(.88); } }
  .tieni::after { content: ''; position: absolute; inset: -4px; border-radius: 999px; border: 2px solid var(--terracotta); animation: tieni-onda 1.8s var(--uscita) infinite; pointer-events: none; }
  @keyframes tieni-onda { 0% { opacity: .9; transform: scale(1); } 100% { opacity: 0; transform: scale(1.12, 1.35); } }
  .tieni { overflow: visible; isolation: isolate; }
  .tieni-riempi { border-radius: 999px; overflow: hidden; }
  .tieni.usato::after, .tieni.premuto::after, .tieni.usato .tieni-dito svg { animation: none; opacity: 0; }
  .tieni.usato .tieni-dito svg { opacity: 1; }
  @media (prefers-reduced-motion: reduce) { .gesto-cursore, .gesto-scia, .gesto-anello, .tieni::after, .tieni-dito svg { animation: none; } .gesto-label .l2 { display: none; } }
  /* ---------- MOBILE: ogni sezione in una schermata ---------- */
  .scorri { display: none; }
  @media (max-width: 860px) {
    .scorri { display: inline-flex; align-items: center; gap: .4rem; font-size: .7rem; letter-spacing: .14em; text-transform: uppercase; color: var(--fg-2); }
    .scorri span { display: inline-block; animation: scorri 1.6s var(--respiro) infinite; }
    @keyframes scorri { 0%, 100% { transform: translateX(0); } 50% { transform: translateX(6px); } }
    .carosello, .galleria, .media-sezione .griglia-3, .pista-binario {
      display: flex; gap: .75rem; overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x mandatory;
      margin-inline: calc(-1 * var(--gutter)); padding: .25rem var(--gutter) .5rem; scroll-padding-inline: var(--gutter); scrollbar-width: none;
    }
    .galleria::-webkit-scrollbar, .media-sezione .griglia-3::-webkit-scrollbar, .pista-binario::-webkit-scrollbar { display: none; }

    /* le sezioni a griglia non devono allargarsi per colpa delle schede che scorrono */
    .sezione { grid-template-columns: minmax(0, 1fr); }
    .pista-stage { overflow: hidden; }

    /* Hero */
    .hero { min-height: 100svh; padding-top: 4.6rem; padding-bottom: 1rem; display: grid; align-content: center; }
    .hero-grid { gap: 1.4rem; }
    .hero-testo { gap: .95rem; }
    .hero-foto { width: min(76vw, 44svh); padding: .3rem; }
    .hero h1 { font-size: clamp(2.2rem, 10.5vw, 3rem); max-width: none; }
    .hero .lead { font-size: 1rem; }
    .pill { font-size: .78rem; padding: .32rem .65rem; }
    .piani-pill { gap: .35rem; margin-top: -.2rem; }
    .hero-cta .btn { min-height: 3rem; padding-inline: 1rem; }
    .fiducia, .solo-desk, .solo-desk-flex { display: none !important; }
    .hero-ruolo { font-size: .66rem; }
    .hero-chi { gap: .15rem; }
    .piani-pill { flex-wrap: nowrap; }
    .pill { font-size: .72rem; padding: .28rem .5rem; gap: .35rem; }
    .pill-punto { width: 6px; height: 6px; }
    :global(.hero-cred) { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: .45rem; order: 1; }
    .hero-cta { order: 2; padding-right: 4.6rem; }
    :global(.hero-cred .cred-val) { white-space: nowrap; }
    :global(.hero-cred li:last-child .cred-val) { white-space: normal; line-height: 1.15; }
    :global(.hero-cred .credenziale) { height: 100%; padding: .45rem .55rem; gap: .45rem; border-radius: 12px; }
    :global(.hero-cred .mindup-logo) { height: 1.75rem; padding-right: .45rem; }
    :global(.hero-cred .mindup-segnaposto) { font-size: .82rem; }
    :global(.hero-cred .cred-val) { font-size: .76rem; }
    :global(.hero-cred .cred-lab) { font-size: .52rem; }

    /* La sfera */
    .mente { min-height: 100svh; display: grid; align-content: center; }
    .mente-grid { gap: 1.6rem; }
    .mente-testo { gap: .8rem; }
    .mente-testo .lead { font-size: 1rem; }
    .mente-legenda { display: none; }
    .mente-stage { gap: 1.25rem; }
    .mente-ancora { width: min(88vw, 40svh); }
    .angolo { font-size: .74rem; padding: .22rem .55rem; }
    .a1, .a2 { top: -2%; } .a3, .a4 { bottom: -2%; }
    .a1, .a3 { left: -9%; } .a2, .a4 { right: -9%; }
    .tieni { min-height: 3.5rem; padding-block: .5rem; }
    .tieni-testo { font-size: 1rem; }
    .tel-testa { display: none; }
    .tel-svg { display: none; }
    .tel-msg { margin-top: .2rem; font-size: .72rem; }

    /* Porte */
    .porte-sezione { min-height: 100svh; display: grid; align-content: center; }
    .porta { padding: .7rem .9rem; gap: .8rem; }
    .porta-icona { width: 2.2rem; height: 2.2rem; border-radius: 10px; }
    .porta-nome { font-size: 1.12rem; }
    .porta-esito { margin-top: .75rem; padding: .9rem 1rem; }

    /* Respiro */
    .respiro { min-height: 100svh; display: grid; align-content: center; }
    .respiro-grid { gap: 1.25rem; }
    .respiro-testo { gap: .8rem; }
    .respiro-stage { width: min(68vw, 34svh); }

    /* Cruscotto */
    .cruscotto { min-height: 100svh; display: grid; align-content: center; }
    .cruscotto-layout { gap: .6rem; }
    .cruscotto-head { margin-bottom: .25rem; }
    .cruscotto-grid { grid-template-columns: 1fr 1fr; grid-template-areas: 's1 s2' 's3 s4'; gap: .7rem; }
