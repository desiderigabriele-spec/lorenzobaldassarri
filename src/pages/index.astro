  /* ---------- MEDIA ---------- */
  .media-scheda { display: grid; gap: .75rem; height: 100%; text-decoration: none; position: relative; transition: border-color .5s var(--respiro), transform .6s var(--respiro); }
  .media-scheda:hover { border-color: var(--inchiostro); transform: translateY(-3px); }
