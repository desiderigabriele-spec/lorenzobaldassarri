---
import Base from '../layouts/Base.astro';
import { porte, piani, contatti, identita } from '../data/sito.js';
import { recensioni } from '../data/recensioni.js';
import FotoGuida from '../components/FotoGuida.astro';
import Credenziali from '../components/Credenziali.astro';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': 'https://www.lorenzobaldassarri.it/#persona',
      name: 'Lorenzo Baldassarri',
      honorificPrefix: 'Dott.',
      image: 'https://www.lorenzobaldassarri.it/img/lorenzo-studio.jpg',
      jobTitle: ['Psicologo esperto di performance', 'Psicologo-Psicoterapeuta', 'Psicologo dello sport', 'Co-founder di MindUP Enhancement Psychology®'],
      worksFor: { '@type': 'Organization', name: 'MindUP Enhancement Psychology®', url: 'https://www.mindup.live/' },
      disambiguatingDescription: 'Psicologo e psicoterapeuta di Montecatini Terme; non il pilota motociclistico omonimo.',
      alumniOf: [
        { '@type': 'CollegeOrUniversity', name: 'Università degli Studi di Firenze' },
        { '@type': 'CollegeOrUniversity', name: 'Università degli Studi di Urbino Carlo Bo' },
      ],
      memberOf: { '@type': 'Organization', name: 'Ordine degli Psicologi della Toscana' },
      affiliation: { '@type': 'CollegeOrUniversity', name: 'Università degli Studi di Parma' },
      knowsAbout: ['Psicologia del Potenziamento', 'Psicologia della performance', 'Psicologia dello sport', 'Psicoterapia funzionale', 'Mental training', 'Gestione dello stress', 'Ansia da prestazione'],
      sameAs: [
        'https://www.linkedin.com/in/lorenzo-baldassarri-70b39343/',
        'https://www.mindup.live/',
        'https://www.eljos.it/dott-lorenzo-baldassarri/',
      ],
    },
    {
      '@type': 'ProfessionalService',
      name: 'Studio del Dott. Lorenzo Baldassarri — Psicologo e Psicoterapeuta',
      address: { '@type': 'PostalAddress', streetAddress: contatti.indirizzo, postalCode: '51016', addressLocality: 'Montecatini Terme', addressRegion: 'PT', addressCountry: 'IT' },
      founder: { '@id': 'https://www.lorenzobaldassarri.it/#persona' },
      logo: 'https://www.lorenzobaldassarri.it/logo/01-monogramma-completo-blu-notte.svg',
      areaServed: 'IT',
    },
  ],
};

// "Ti riconosci?": situazioni comuni, ognuna legata a una delle 4 parti di te
const situazioni = [
  { testo: 'Prima di un esame o di una gara mi blocco', parte: 'corpo',
    spiega: 'Il corpo sente il pericolo e tira il freno: la testa sa cosa fare, ma i muscoli si irrigidiscono.',
    lavoro: 'Alleniamo il corpo a restare sciolto sotto pressione, con esercizi brevi da usare proprio prima della prova.' },
  { testo: 'La notte la testa non si spegne', parte: 'pensiero',
    spiega: 'La testa continua a cercare soluzioni anche quando non serve, e il sonno non arriva.',
    lavoro: 'Impariamo a spegnere il rumore dei pensieri, con esercizi semplici da fare la sera.' },
  { testo: 'So cosa fare, ma nel momento giusto non ci riesco', parte: 'pensiero',
    spiega: 'Sapere non basta: sotto pressione testa, emozioni e corpo devono lavorare insieme, e a volte non lo fanno.',
    lavoro: 'Ci alleniamo nelle condizioni vere, non solo a parole, finché il gesto ti viene anche quando conta.' },
  { testo: 'Mi sento sempre in allarme', parte: 'fisiologia',
    spiega: 'Il tuo allarme interno è rimasto acceso: battito e respiro corrono anche quando non c’è pericolo.',
    lavoro: 'Insegniamo al corpo ad abbassare il volume, partendo dal respiro. Puoi provarlo qui sotto.' },
  { testo: 'Dopo un errore non riesco a ripartire', parte: 'emozione',
    spiega: 'L’errore accende rabbia o paura, e quelle emozioni restano attaccate anche al momento dopo.',
    lavoro: 'Ti alleni a lasciar andare l’errore in pochi secondi e a tornare su quello che stai facendo.' },
  { testo: 'Anche quando riposo, non mi ricarico', parte: 'fisiologia',
    spiega: 'Se il corpo non stacca mai davvero, anche il riposo non basta a ricaricarti.',
    lavoro: 'Lavoriamo su respiro e recupero, per tornare ad avere energia nella giornata.' },
  { testo: 'Ho paura di deludere gli altri', parte: 'emozione',
    spiega: 'Quando il giudizio degli altri pesa più di quello che fai, la paura prende il comando.',
    lavoro: 'Ritroviamo fiducia e la tua misura: cosa vuoi tu, non cosa si aspettano gli altri.' },
  { testo: 'Ho spalle e collo sempre contratti', parte: 'corpo',
    spiega: 'Il corpo trattiene la tensione che accumuli durante il giorno, spesso senza che te ne accorga.',
    lavoro: 'Esercizi per sciogliere la tensione e per accorgerti prima quando sta salendo.' },
];

// frasi che la persona dice a sé stessa: in equilibrio / sotto pressione (stesso ordine dei piani)
const frasiCalme = ['Sono concentrato', 'Carico giusto', 'Sciolto', 'Respiro calmo'];

const icone = {
  atleti: 'M12 3l2.4 5 5.6.8-4 3.9.9 5.5L12 15.6 7.1 18.2l.9-5.5-4-3.9 5.6-.8z',
  squadre: 'M8 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6zm8 0a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM2 20c0-3.3 2.7-6 6-6s6 2.7 6 6m-2.4-5.6A6 6 0 0 1 22 20',
  aziende: 'M4 8h16v11H4zM9 8V5h6v3M4 13h16',
  motorsport: 'M5 21V4m0 1h11l-2 3.5L16 12H5',
  psicoterapia: 'M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z',
};
const autorita = ['Formula Medicine 2013–16', 'Academy toscana F.I.R.', 'Università di Parma', 'KM2025 · Università di Siena', 'Radio Bianconera', 'RTV38', 'Scienza & Sport'];

const numeri = [
  { valore: '15+', label: 'anni di psicoterapia a Montecatini Terme' },
  { valore: '20+', label: 'anni di calcio, da giocatore e allenatore' },
  { valore: '3', label: 'anni in Formula 1 con Formula Medicine' },
  { valore: 'Dal 2017', label: "docente all'Università di Parma" },
];

// "Chi sono": il percorso, studi e incarichi insieme
const percorso = [
  { quando: 'Prima', titolo: 'Il campo', testo: "Vent'anni da calciatore, poi allenatore dei bambini." },
  { quando: '2010–2014', titolo: 'Gli studi', testo: 'Psicologia clinica, poi la specializzazione in psicoterapia.' },
  { quando: 'Dal 2011', titolo: 'Lo studio', testo: 'A Montecatini Terme: ansia, stress, momenti difficili.' },
  { quando: '2013–2016', titolo: 'La Formula 1', testo: 'Preparazione mentale di piloti di F1, calciatori di Serie A, atleti olimpici.' },
  { quando: 'Dal 2017', titolo: "L'università", testo: "Insegno all'Università di Parma." },
  { quando: 'Dal 2021', titolo: 'Il mio metodo', testo: 'Ho creato la Psicologia del Potenziamento® e co-fondato MindUP.' },
];

const giri = [
  { titolo: 'Ci conosciamo', testo: 'Mi racconti cosa succede. Io ascolto, senza giudicare.' },
  { titolo: 'Capiamo', testo: 'Guardiamo insieme testa, emozioni, corpo e respiro. Se serve, con strumenti che misurano lo stress.' },
  { titolo: 'Ci alleniamo', testo: 'Esercizi su misura, in studio, online o sul campo.' },
  { titolo: 'Controlliamo', testo: 'Vediamo cosa è migliorato e aggiustiamo il percorso.' },
];

const domande = [
  {
    q: 'Quando sale la pressione, cosa cambia per primo?',
    r: ['I pensieri corrono', 'Sale la paura di sbagliare', 'I muscoli si irrigidiscono', 'Il cuore accelera'],
  },
  {
    q: 'Quando sbagli qualcosa, cosa ti resta addosso?',
    r: ['Ci ripenso di continuo', 'Rabbia o sconforto', 'Mi blocco', 'Mi manca il fiato'],
  },
  {
    q: 'La notte prima di un momento importante…',
    r: ['La testa non si spegne', 'Sono agitato', 'Il corpo non si rilassa', 'Dormo male, battito veloce'],
  },
  {
    q: 'Nel momento importante ti capita di…',
    r: ['Pensare troppo', 'Avere paura di sbagliare', 'Irrigidirti', 'Respirare corto'],
  },
  {
    q: 'Cosa vorresti migliorare?',
    r: ['Restare concentrato', 'Gestire ansia e paura', 'Sentirmi più sciolto', 'Dormire e recuperare meglio'],
  },
];

const faq = [
  { q: 'Devo stare molto male per andare dallo psicologo?', a: 'No. Si va anche per stare meglio, per capire cosa succede o per prepararsi a un momento importante. Come si va dal medico sportivo senza essere infortunati.' },
  { q: 'Quanto costa?', a: 'Dipende dal tipo di percorso. Te lo dico subito, al primo contatto e prima di iniziare: nessuna sorpresa.' },
  { q: 'Quanto dura? Ogni quanto ci vediamo?', a: "All'inizio di solito ci si vede una volta a settimana, poi più di rado. Dopo il primo colloquio ti propongo un piano chiaro, con tempi e verifiche." },
  { q: 'Online funziona come in studio?', a: 'Sì. Per molte persone è anche più comodo. Puoi scegliere tu, e cambiare quando vuoi.' },
  { q: 'Quello che dico resta tra noi?', a: 'Sì. Lo psicologo è tenuto per legge al segreto professionale.' },
  { q: 'Serve la ricetta del medico?', a: 'No. Puoi scrivermi o chiamarmi direttamente.' },
  { q: 'E se non mi trovo bene?', a: 'Me lo dici, senza problemi. Il primo colloquio serve anche a questo: capire se possiamo lavorare bene insieme.' },
  { q: 'Psicologo dello sport o mental coach?', a: "Lo psicologo dello sport è un professionista sanitario iscritto all'Albo, con formazione clinica. Il mental coach no: è un titolo non regolamentato." },
  { q: 'Lavori con i ragazzi?', a: 'Sì, sempre con il consenso dei genitori, che coinvolgo nel percorso. Nessun dato o immagine dei ragazzi viene reso pubblico.' },
  { q: 'Sport o psicoterapia: che differenza c’è?', a: 'Nello sport alleniamo le tue risorse per un obiettivo. La psicoterapia aiuta quando c’è una sofferenza. Se non sai quale ti serve, lo capiamo insieme al primo colloquio.' },
];

const iniziali = (nome) => nome.replace(/^Dr\.ssa\s+|^Dott\.\s+/, '').split(/\s+/).map((p) => p[0]).slice(0, 2).join('');

const media = [
  { tipo: 'Convegno · 2025', titolo: 'KM2025, Industry Day', testo: 'Invited talk sul metodo, Università di Siena.', href: 'https://www.iiakm.org/conference/KM2025/pdfs/KM2025_Industry-Day-Invited-Talk_BALDASSARRI.pdf' },
  { tipo: 'TV · RTV38', titolo: 'Salute e prestazione', testo: 'Ospite del programma Tada con Riccardo Paterni.', href: 'https://www.mindup.live/en/blog/67/lorenzo-baldassarri-and-riccardo-paterni-talk-about-health-and-performance-in-the-rtv38-s-tada--television-program' },
  { tipo: 'Articolo · TagMedicina', titolo: 'Sport, relax, ansia e stress', testo: 'Perché il movimento è anche un allenamento mentale.', href: 'https://www.tagmedicina.it/2022/02/05/lo-sport-relax-ansia-stress/' },
];
---
<Base
  title="Dott. Lorenzo Baldassarri – Psicologo, Psicoterapeuta e Psicologo dello sport a Montecatini Terme"
  description="Psicologo e psicoterapeuta a Montecatini Terme e online. Quando ansia, stress o pressione ti bloccano, lavoriamo insieme su testa, emozioni, corpo e respiro. Per stare meglio e dare il meglio."
  jsonLd={jsonLd}
>
  <canvas class="tela-3d" aria-hidden="true"></canvas>

  <!-- 1 · HERO: la persona -->
  <section class="sezione hero" data-theme="carta" aria-labelledby="hero-titolo">
    <div class="wrap hero-grid">
      <div class="hero-testo">
        <p class="hero-ruolo mono" data-reveal>Psicologo e psicoterapeuta<span class="solo-desk"> · Montecatini Terme e online</span></p>
        <h1 id="hero-titolo" data-reveal style="--d:.08s">Ritrova il tuo <span class="evidenza">equilibrio.</span><span class="h1-sotto">In terapia, in gara, al lavoro.</span></h1>
        <p class="lead" data-reveal style="--d:.16s">Quando ansia, stress o pressione ti bloccano, lavoriamo insieme su testa, emozioni, corpo e respiro. Per stare meglio e dare il meglio.</p>
        <nav class="hero-strade" aria-label="Da dove vuoi partire" data-reveal style="--d:.2s">
          <a href="/psicoterapia"><span class="mono">Psicoterapia</span> Voglio stare meglio <span aria-hidden="true">→</span></a>
          <a href="/psicologo-dello-sport"><span class="mono">Sport e lavoro</span> Voglio dare il meglio <span aria-hidden="true">→</span></a>
        </nav>
        <div class="hero-cta" data-reveal style="--d:.24s">
          <a class="btn btn-primario" href="/contatti" data-cta>Prenota il primo colloquio</a>
          <a class="btn btn-secondario solo-desk-flex" href="#riconosci">Come funziona <span class="freccia" aria-hidden="true">↓</span></a>
        </div>
        <p class="rassicura" data-reveal style="--d:.28s"><span>In studio o online</span><span>Risposta entro un giorno lavorativo</span><span>Segreto professionale</span></p>
        <Credenziali classe="hero-cred" />
        <p class="fiducia mono" data-reveal style="--d:.32s">Albo Psicologi Toscana n. {contatti.albo} · Docente Università di Parma</p>
      </div>
      <div class="hero-foto" data-reveal style="--d:.12s">
        <div class="aurora" aria-hidden="true"><span class="b1"></span><span class="b2"></span><span class="b3"></span><span class="b4"></span></div>
        <FotoGuida tipo="ritratto" src={contatti.foto} alt="Il Dott. Lorenzo Baldassarri nel suo studio di Montecatini Terme" classe="foto-hero" fuoco="50% 22%" eager guida={['Verticale 4:5, mezzo busto', 'Sguardo verso sinistra (verso il titolo)', 'Luce laterale morbida, sfondo neutro']} />
        <span class="badge badge-1"><span class="mono">dal 2011</span> Psicologo · Psicoterapeuta</span>
        <span class="badge badge-2"><span class="mono">Creatore</span> Psicologia del Potenziamento®</span>
        <span class="badge badge-3"><span class="mono">2013–16</span> Formula 1 con Formula Medicine</span>
      </div>
    </div>
  </section>

  <!-- 2 · TI RICONOSCI? -->
  <section class="sezione riconosci-sezione" id="riconosci" data-theme="carta" aria-labelledby="riconosci-titolo">
    <div class="wrap">
      <div class="sezione-head">
        <p class="eyebrow" data-reveal>Ti riconosci?</p>
        <h2 id="riconosci-titolo" data-reveal>Tocca le frasi che ti somigliano.</h2>
        <p class="lead" data-reveal>Per ognuna ti spiego perché succede e cosa possiamo fare insieme.</p>
      </div>
      <div class="riconosci-corpo">
      <div class="situazioni" role="group" aria-label="Situazioni in cui ti riconosci">
        {situazioni.map((x, i) => (
          <button type="button" class={`situazione p-${x.parte}`} aria-pressed="false" data-parte={x.parte} data-spiega={x.spiega} data-lavoro={x.lavoro} data-reveal style={`--d:${i * 0.04}s`}>
            <span class="situazione-punto" aria-hidden="true"></span>{x.testo}
          </button>
        ))}
      </div>
      <div class="riconosci-esito" data-riconosci-esito aria-live="polite" hidden>
        <p class="riconosci-frase" data-riconosci-titolo></p>
        <div class="riconosci-risposta" data-riconosci-risposta>
          <p class="riconosci-quale">Hai toccato: <q data-riconosci-quale></q></p>
          <p><b>Perché succede.</b> <span data-riconosci-spiega></span></p>
          <p><b>Cosa facciamo insieme.</b> <span data-riconosci-lavoro></span></p>
        </div>
        <div class="riconosci-mappa">
          <p class="etichetta">La tua mappa: dove senti la pressione</p>
          <ul role="list">
            {piani.map((p) => (
              <li class={`p-${p.id}`} data-mappa={p.id}><span>{p.nome}</span><span class="mappa-barra"><i></i></span></li>
            ))}
          </ul>
        </div>
        <div class="riconosci-azioni">
          <a class="btn btn-primario" href="/contatti" data-cta>Prenota il primo colloquio</a>
          <a class="link-freccia" href="#mente" data-riconosci-link><span data-riconosci-link-testo>Prova: cosa ti succede sotto pressione</span> <span aria-hidden="true">↓</span></a>
        </div>
      </div>
      <div class="riconosci-vuoto" aria-hidden="true">
        <span class="riconosci-vuoto-mano">👆</span>
        <p>Tocca una frase a sinistra.<br />Qui trovi la risposta pensata per te.</p>
      </div>
      </div>
    </div>
  </section>

  <!-- 2 · CHI SONO: il percorso in una linea del tempo -->
  <section class="sezione chi-sezione" id="chi" data-theme="carta" aria-labelledby="chi-titolo">
    <div class="wrap">
      <div class="sezione-head chi-head">
        <p class="eyebrow" data-reveal>Chi sono</p>
        <h2 id="chi-titolo" data-reveal>Ho giocato, ho studiato, ho lavorato con i campioni. Ora sono qui per te.</h2>
        <p class="lead" data-reveal>Mi chiamo Lorenzo. Dal 2011 aiuto ragazzi, adulti, atleti e manager a stare meglio e a dare il meglio quando la pressione sale.</p>
      </div>
      <ol class="percorso" role="list">
        {percorso.map((t, i) => (
          <li class="tappa-p" data-reveal style={`--d:${i * 0.07}s`}>
            <span class="tappa-quando">{t.quando}</span>
            <h3>{t.titolo}</h3>
            <p class="muted">{t.testo}</p>
          </li>
        ))}
      </ol>
      <a class="link-freccia chi-link" href="/chi-sono" data-reveal>Studi e incarichi completi <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <!-- 3 · PERCHÉ LA PSICOLOGIA FUNZIONALE: il palazzo resta fermo, le frasi scorrono e lo costruiscono -->
  <section class="sezione perche" id="perche" data-theme="carta" aria-labelledby="perche-titolo">
    <div class="wrap">
      <div class="sezione-head perche-head">
        <p class="eyebrow" data-reveal>Il mio metodo</p>
        <h2 id="perche-titolo" data-reveal>Perché a volte capire non basta.</h2>
        <p class="lead" data-reveal>Puoi capire benissimo cosa ti succede e stare male lo stesso. Perché ansia e stress non stanno solo nella testa: stanno anche nelle emozioni, nel corpo e nel respiro.</p>
      </div>
      <div class="storia">
        <figure class="torre-box">
        <svg class="torre-svg" viewBox="0 0 320 440" role="img" aria-labelledby="torre-didascalia">
          <line class="terreno" x1="20" y1="330" x2="300" y2="330" />
          <g class="fondamenta">
            {piani.map((p, i) => (
              <g class={`fondo p-${p.id}`} data-fondo={i}>
                <rect x="70" y={336 + i * 22} width="180" height="18" rx="4" />
                <text x="258" y={349 + i * 22}>{p.nome}</text>
              </g>
            ))}
          </g>
          <g class="torre">
            {Array.from({ length: 8 }, (_, k) => (
              <g class="piano-torre" data-piano={k}>
                <rect x="100" y={296 - k * 34} width="120" height="32" rx="3" />
                <rect class="finestra" x="112" y={306 - k * 34} width="18" height="12" rx="2" />
                <rect class="finestra" x="151" y={306 - k * 34} width="18" height="12" rx="2" />
                <rect class="finestra" x="190" y={306 - k * 34} width="18" height="12" rx="2" />
              </g>
            ))}
            <path class="crepa" d="M150 300 L 158 262 L 149 230 L 161 190" />
            <path class="crepa" d="M190 232 L 182 200 L 194 170" />
          </g>
          <g class="oscilla-segni" aria-hidden="true"><path d="M58 120 q -10 22 0 44" /><path d="M262 120 q 10 22 0 44" /></g>
          <g class="etichetta-risultati" aria-hidden="true">
            <path d="M232 60 h8 v236 h-8" />
            <text x="248" y="170">I tuoi</text><text x="248" y="186">obiettivi</text>
          </g>
          <text class="etichetta-base" x="160" y="352" text-anchor="middle" aria-hidden="true">Base stretta: una parte sola</text>
          <text class="etichetta-fondamenta" x="62" y="381" text-anchor="end" aria-hidden="true">Fondamenta</text>
        </svg>
          <figcaption id="torre-didascalia" class="torre-didascalia" aria-live="polite"><span data-fase>Questo palazzo sono i tuoi obiettivi.</span></figcaption>
        </figure>
        <div class="passi">
          <article class="passo" data-passo="0">
            <p class="etichetta">Il palazzo</p>
            <h3>Il palazzo sono i tuoi obiettivi.</h3>
            <p class="muted">Stare sereno, dormire bene, dare il meglio. Più il palazzo sale, più ottieni.</p>
          </article>
          <article class="passo" data-passo="1">
            <p class="etichetta etichetta-rischio">Il rischio</p>
            <h3>Se lavori su una parte sola, la base è stretta.</h3>
            <p class="muted">Funziona per un po’, poi alla prima difficoltà traballa:</p>
            <ol class="limiti" role="list">
              <li><strong>Cambia solo la superficie.</strong> <span class="muted">Va meglio finché segui la tecnica, poi torna come prima.</span></li>
              <li><strong>Funziona solo in un caso.</strong> <span class="muted">Se la situazione cambia, non basta più.</span></li>
              <li><strong>Si torna indietro.</strong> <span class="muted">Basta un imprevisto e si perde quello che hai fatto.</span></li>
            </ol>
          </article>
          <article class="passo" data-passo="2">
            <p class="etichetta etichetta-metodo">Le fondamenta</p>
            <h3>Io costruisco le fondamenta.</h3>
            <p class="muted">Lavoriamo su tutte e 4 le parti di te, insieme, alle radici di quello che senti. E ritrovi capacità che hai già:</p>
            <ul class="esperienze" role="list">
              <li>Calma</li><li>Forza</li><li>Sentirti al sicuro</li><li>Stare bene con gli altri</li>
            </ul>
          </article>
          <article class="passo" data-passo="3">
            <p class="etichetta etichetta-ok">Il risultato</p>
            <h3>Così il palazzo regge, anche quando la vita spinge forte.</h3>
            <p class="muted">Il metodo si chiama Psicologia Funzionale: una psicoterapia che lavora su mente e corpo insieme.</p>
            <a class="link-freccia" href="/metodo">Approfondisci il metodo <span aria-hidden="true">→</span></a>
          </article>
        </div>
      </div>
    </div>
  </section>

  <!-- 2 · LA SFERA: la tua mente sotto pressione -->
  <section class="sezione mente" id="mente" data-theme="carta" data-stato="mente" aria-labelledby="mente-titolo">
    <div class="wrap mente-grid">
      <div class="mente-testo">
        <p class="eyebrow" data-reveal>Prova tu · 10 secondi</p>
        <h2 id="mente-titolo" data-reveal>Cosa ti succede sotto pressione?</h2>
        <p class="lead" data-reveal>Questa sfera sei tu. <strong class="hint-fine evidenziatore">Muovi il cursore veloce</strong><strong class="hint-touch evidenziatore">Tieni premuto</strong>: è come quando sei sotto pressione, ogni parte di te va per conto suo. <strong class="hint-fine evidenziatore e2">Fermati</strong><strong class="hint-touch evidenziatore e2">Lascia</strong>: tornano insieme.</p>
        <button type="button" class="come-si-usa" data-guida="mente"><span aria-hidden="true">?</span> Come si usa</button>
      </div>
      <div class="mente-stage">
        <p class="mente-stato" data-mente-stato aria-live="polite">In equilibrio: le tue parti lavorano insieme</p>
        <div class="mente-ancora" data-ancora>
          <div class="gesto" aria-hidden="true">
            <svg class="gesto-cursore" viewBox="0 0 24 24"><path d="M4 2l16 9.5-7 1.6L9.6 20z" /></svg>
            <span class="gesto-scia"></span>
            <span class="gesto-anello"></span>
            <span class="gesto-label"><span class="l1">Muovi veloce</span><span class="l2">Ora fermati</span></span>
          </div>
          {piani.map((p, i) => <span class={`angolo a${i + 1} p-${p.id}`} aria-hidden="true"><b>{p.nome}</b><span data-frase={i}>{frasiCalme[i]}</span></span>)}
        </div>
        <button type="button" class="tieni" data-tieni aria-describedby="mente-titolo">
          <span class="tieni-riempi" aria-hidden="true"></span>
          <span class="tieni-dito" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M9 11V5.5a1.5 1.5 0 0 1 3 0V10m0-.5V8a1.5 1.5 0 0 1 3 0v2m0-.5a1.5 1.5 0 0 1 3 0V15a6 6 0 0 1-6 6h-1a6 6 0 0 1-4.7-2.3L4 15.5a1.6 1.6 0 0 1 2.4-2.1L9 15" /></svg></span>
          <span class="tieni-testo">Tieni premuto</span>
        </button>
        <div class="pressometro" aria-hidden="true">
          <span class="mono">Quanta pressione senti</span>
          <span class="pressometro-barra"><span data-pressione-barra></span></span>
          <span class="mono pressometro-val" data-pressione-val>0%</span>
        </div>
        <div class="telemetria">
          <div class="tel-testa mono">
            <span class="tel-live"><span class="tel-punto"></span> Battito · esempio</span>
            <span><span class="tel-bpm" data-bpm>62</span> bpm</span>
          </div>
          <svg class="tel-svg" viewBox="0 0 1000 120" preserveAspectRatio="none" role="img" aria-label="Linea del battito illustrativa: si agita quando ti muovi in fretta, si calma quando ti fermi.">
            <line x1="0" y1="60" x2="1000" y2="60" class="tel-asse" />
            <path class="tel-linea" d="M0 60 L1000 60" />
          </svg>
          <p class="tel-msg mono" aria-live="polite"><span class="hint-fine">Muoviti veloce, poi fermati.</span><span class="hint-touch">Tieni premuto, poi lascia.</span></p>
        </div>
      </div>
      <div class="mente-legenda">
        <ol class="legenda" role="list">
          {piani.map((p, i) => (
            <li class={`p-${p.id}`} data-reveal style={`--d:${i * 0.06}s`}>
              <span class="legenda-punto"></span>
              <span><strong>{p.nome}</strong> <span class="muted">{p.esempio}</span></span>
            </li>
          ))}
        </ol>
        <p class="mente-sintesi" data-reveal>Il mio lavoro è tenerle insieme, <span class="evidenza">anche quando la pressione sale.</span></p>
      </div>
    </div>
  </section>


  <!-- 4 · RESPIRA CON ME -->
  <section class="sezione respiro" id="respiro" data-theme="carta" data-stato="respiro" aria-labelledby="respiro-titolo">
    <div class="wrap respiro-grid">
      <div class="respiro-testo">
        <p class="eyebrow" data-reveal>Prova tu · 30 secondi</p>
        <h2 id="respiro-titolo" data-reveal>Calmati in 30 secondi.</h2>
        <p class="lead" data-reveal>Inspira contando fino a 4, butta fuori l’aria contando fino a 6. Quando espiri più a lungo, il cuore rallenta. È il primo esercizio che insegno.</p>
        <div class="respiro-azioni" data-reveal>
          <button class="btn btn-primario" type="button" data-respiro-start>Inizia <span class="mono" style="opacity:.8">30 s</span></button>
          <button class="btn btn-secondario" type="button" data-respiro-stop hidden>Interrompi</button>
        </div>
        <div class="respiro-fine" hidden>
          <p class="h3">Come ti senti?</p>
          <p class="muted">Questo era un esercizio. In un percorso ne impari tanti, su misura per te.</p>
          <a class="btn btn-primario" href="/contatti" data-cta>Prenota il primo colloquio</a>
        </div>
      </div>
      <div class="respiro-stage" data-ancora>
        <svg class="respiro-anello" viewBox="0 0 200 200" aria-hidden="true">
          <circle cx="100" cy="100" r="96" class="anello-guida" />
          <circle cx="100" cy="100" r="96" class="anello-progresso" pathLength="1" />
        </svg>
        <div class="respiro-centro">
          <p class="respiro-fase display" aria-live="assertive">Pronto?</p>
          <p class="respiro-conto mono" data-respiro-conto>30</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 5 · IL CRUSCOTTO -->
  <section class="sezione cruscotto" id="cruscotto" data-theme="cruscotto" data-stato="cruscotto" aria-labelledby="cruscotto-titolo">
    <div class="wrap cruscotto-layout">
      <div class="sezione-head cruscotto-head">
        <p class="eyebrow" data-reveal>Cosa cambia lavorandoci</p>
        <h2 id="cruscotto-titolo" data-reveal>Una parte va in tilt? Si trascina dietro le altre.</h2>
        <p class="lead" data-reveal>Sposta una parte fino al rosso: guarda, peggiorano anche le altre. Poi tocca «Dopo il percorso» e riprova.</p>
        <button type="button" class="come-si-usa" data-guida="cruscotto"><span aria-hidden="true">?</span> Come si usa</button>
      </div>

      <div class="cruscotto-grid">
        {piani.map((p, i) => (
          <button class={`strumento s${i + 1} p-${p.id}`} type="button" data-strumento={p.id} aria-pressed={i === 0 ? 'true' : 'false'} aria-controls="pressione">
            <svg viewBox="0 0 120 72" aria-hidden="true">
              <path class="arco-base" d="M12 62 A48 48 0 0 1 108 62" />
              <path class="arco-zone" d="M12 62 A48 48 0 0 1 108 62" />
              <line class="lancetta" x1="60" y1="62" x2="60" y2="22" />
              <circle cx="60" cy="62" r="3.5" class="perno" />
            </svg>
            <span class="strumento-nome">{p.nome}</span>
            <span class="strumento-val mono"><span data-val>—</span></span>
          </button>
        ))}
        <div class="cruscotto-ancora" data-ancora aria-hidden="true"></div>
      </div>
      <svg class="defs-cruscotto" width="0" height="0" aria-hidden="true" focusable="false">
        <defs>
          <linearGradient id="zone-equilibrio" gradientUnits="userSpaceOnUse" x1="12" y1="0" x2="108" y2="0">
            <stop offset="0" stop-color="#FF4D4F" /><stop offset=".14" stop-color="#FF8A3D" /><stop offset=".3" stop-color="#FFD23F" /><stop offset=".42" stop-color="#8BE38B" /><stop offset=".5" stop-color="#2EE6D6" /><stop offset=".58" stop-color="#8BE38B" /><stop offset=".7" stop-color="#FFD23F" /><stop offset=".86" stop-color="#FF8A3D" /><stop offset="1" stop-color="#FF4D4F" />
          </linearGradient>
        </defs>
      </svg>

      <div class="pressione">
        <div class="allenamento" role="group" aria-label="Allenamento">
          <button type="button" data-allenato="no" aria-pressed="true">Oggi</button>
          <button type="button" data-allenato="si" aria-pressed="false">Dopo il percorso</button>
        </div>
        <label for="pressione" class="mono pressione-lab">Stai muovendo: <span data-piano-scelto>Testa</span></label>
        <input id="pressione" type="range" min="0" max="100" value="50" step="1" aria-valuetext="Testa in equilibrio" />
        <output class="mono pressione-out" for="pressione">In equilibrio</output>
        <button type="button" class="pressione-reset mono" data-equilibrio>Riporta tutto al centro</button>
      </div>

      <p id="cruscotto-dettaglio" class="cruscotto-dettaglio" aria-live="polite">Tutto in equilibrio: le tue parti lavorano insieme.</p>
      <div class="cruscotto-chiusa">
        <p class="h3" data-reveal>Il pensiero positivo muove una lancetta.<br /><span class="accento">Io alleno tutte e quattro.</span></p>
        <a class="link-freccia" href="/metodo">Il metodo in dettaglio <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <!-- 7 · COME LAVORO -->
  <section class="sezione giri-sezione" data-theme="carta" aria-labelledby="giri-titolo">
    <div class="wrap">
      <div class="sezione-head">
        <p class="eyebrow" data-reveal>Come lavoro</p>
        <h2 id="giri-titolo" data-reveal>Come funziona, passo dopo passo.</h2>
      </div>
      <ol class="giri" role="list">
        {giri.map((g, i) => (
          <li class="giro" data-reveal style={`--d:${i * 0.08}s`}>
            <span class="giro-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <div class="giro-testo">
              <h3>{g.titolo}</h3>
              <p class="muted">{g.testo}</p>
            </div>
          </li>
        ))}
      </ol>
      <aside class="prima-volta" data-reveal aria-labelledby="prima-volta-t">
        <p id="prima-volta-t" class="etichetta etichetta-ok">La prima volta</p>
        <p>Il primo colloquio si fa in studio a Montecatini Terme o online. <b>Parli tu, al tuo ritmo.</b> Alla fine sai se e come posso aiutarti. Non devi preparare niente.</p>
        <a class="btn btn-primario" href="/contatti" data-cta>Prenota il primo colloquio</a>
      </aside>
    </div>
  </section>

  <!-- RECENSIONI: nastro che scorre all'infinito, si ferma e si trascina -->
  <section class="sezione recensioni-sezione" id="recensioni" data-theme="cruscotto" aria-labelledby="recensioni-titolo">
    <div class="wrap recensioni-head">
      <div class="sezione-head">
        <p class="eyebrow" data-reveal>Recensioni verificate</p>
        <h2 id="recensioni-titolo" data-reveal>Lo dicono loro.</h2>
        <p class="lead" data-reveal>Atleti, allenatori e manager che hanno fatto il percorso. Nomi veri, parole loro.</p>
      </div>
      <div class="rec-comandi" data-reveal>
        <button type="button" class="rec-btn" data-rec-prec aria-label="Recensione precedente"><span aria-hidden="true">←</span></button>
        <button type="button" class="rec-btn rec-play" data-rec-play aria-label="Ferma lo scorrimento">
          <svg class="ico-pausa" viewBox="0 0 24 24" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1" /><rect x="14" y="5" width="4" height="14" rx="1" /></svg>
          <svg class="ico-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13a1 1 0 0 0 1.5.86l10.4-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5Z" /></svg>
          <span data-rec-play-testo>Ferma</span>
        </button>
        <button type="button" class="rec-btn" data-rec-succ aria-label="Recensione successiva"><span aria-hidden="true">→</span></button>
      </div>
    </div>
    <div class="rec-binario" data-rec-binario>
      <ul class="rec-nastro" data-rec-nastro role="list">
        {[0, 1].map((copia) => recensioni.map((r, i) => (
          <li class={`recensione p-${r.colore}`} aria-hidden={copia ? 'true' : undefined} inert={copia ? true : undefined} data-rec-indice={i}>
            <article class="rec-scheda">
              <div class="rec-top">
                <span class="rec-ambito">{r.ambito}</span>
                <span class="rec-virgolette" aria-hidden="true">“</span>
              </div>
              <p class="rec-frase">{r.frase}</p>
              <p class="rec-testo">{r.testo}</p>
              <button type="button" class="rec-tutto" data-rec-apri>Leggi tutta <span aria-hidden="true">→</span></button>
              <footer class="rec-autore">
                {r.foto
                  ? <img class="rec-foto" src={r.foto} alt="" width="48" height="48" loading="lazy" />
                  : <span class="rec-foto rec-iniziali" aria-hidden="true">{iniziali(r.nome)}</span>}
                <span class="rec-chi">
                  <span class="rec-nome">{r.nome}
                    <svg class="rec-verificata" viewBox="0 0 24 24" role="img" aria-label="Recensione verificata"><title>Recensione verificata</title><path d="M12 1.8l2.4 1.9 3-.3 1 2.9 2.7 1.4-.6 3 1.5 2.6-2 2.3.1 3-2.9.9-1.4 2.7-3-.5L12 22.2l-2.4-1.9-3 .5-1.4-2.7-2.9-.9.1-3-2-2.3 1.5-2.6-.6-3 2.7-1.4 1-2.9 3 .3Z" /><path class="spunta" d="M7.8 12.3l2.8 2.8 5.6-5.8" /></svg>
                  </span>
                  <span class="rec-ruolo">{r.ruolo}</span>
                </span>
              </footer>
            </article>
          </li>
        )))}
      </ul>
    </div>
    <div class="wrap rec-piede">
      <p class="rec-suggerimento mono" aria-hidden="true"><span class="hint-fine">Passa sopra per fermarle · trascina per scorrere</span><span class="hint-touch">Trascina per scorrere · tocca “Leggi tutta”</span></p>
      <a class="link-freccia rec-fonte" href="https://www.mindup.live/reviews.php" target="_blank" rel="noopener">Tutte le recensioni su MindUP <span aria-hidden="true">↗</span><span class="sr-only"> (si apre in una nuova scheda)</span></a>
    </div>
    <dialog class="rec-dialog" data-rec-dialog aria-labelledby="rec-dialog-nome">
      <div class="rec-dialog-corpo" data-rec-dialog-corpo></div>
      <button type="button" class="rec-chiudi" data-rec-chiudi aria-label="Chiudi la recensione"><span aria-hidden="true">✕</span></button>
    </dialog>
  </section>

  <!-- 9 · FIDUCIA: numeri, nomi e media -->
  <section class="sezione autorita-sezione media-sezione" data-theme="carta" aria-labelledby="fiducia-titolo">
    <div class="wrap">
      <div class="sezione-head">
        <p class="eyebrow" data-reveal>Esperienza</p>
        <h2 id="fiducia-titolo" data-reveal>I numeri del mio lavoro.</h2>
      </div>
      <ul class="numeri" role="list">
        {numeri.map((n, i) => (
          <li class="numero" data-reveal style={`--d:${i * 0.08}s`}>
            <span class="numero-val display">{n.valore}</span>
            <span class="numero-lab">{n.label}</span>
          </li>
        ))}
      </ul>
    </div>
    <div class="nastro" aria-hidden="true">
      <div class="nastro-scorre mono">
        {[...autorita, ...autorita].map((a) => <span>{a}</span>)}
      </div>
    </div>
    <ul class="sr-only" role="list">{autorita.map((a) => <li>{a}</li>)}</ul>
    <div class="wrap">
      <p class="fiducia-media h3" data-reveal>Ne ho parlato in TV, all’università e sui giornali.</p>
      <p class="scorri mono" aria-hidden="true">Scorri <span>→</span></p>
      <ul class="griglia-3" role="list">
        {media.map((m, i) => (
          <li data-reveal style={`--d:${i * 0.08}s`}>
            <a class="scheda media-scheda" href={m.href} target="_blank" rel="noopener">
              <span class="mono muted media-tipo">{m.tipo}</span>
              <span class="h3">{m.titolo}</span>
              <span class="muted">{m.testo}</span>
              <span class="media-freccia" aria-hidden="true">↗</span>
              <span class="sr-only">(si apre in una nuova scheda)</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 8 · AUTOVALUTAZIONE -->
  <section class="sezione quiz-sezione" data-theme="carta" id="autovalutazione" aria-labelledby="quiz-titolo">
    <div class="wrap quiz-grid">
      <div class="sezione-head">
        <p class="eyebrow" data-reveal>Mini test · 1 minuto</p>
        <h2 id="quiz-titolo" data-reveal>Tu come reagisci sotto pressione?</h2>
        <p class="lead" data-reveal>5 domande. Nessun dato personale. Non è una diagnosi: è un primo sguardo su di te.</p>
      </div>
      <div class="quiz scheda" data-reveal>
        <div class="quiz-barra" aria-hidden="true"><span></span></div>
        {domande.map((d, i) => (
          <fieldset class="quiz-domanda" data-domanda={i} hidden={i !== 0}>
            <legend class="h3"><span class="mono quiz-n">{i + 1}/5</span> {d.q}</legend>
            <div class="quiz-scelte">
              {d.r.map((r, j) => (
                <button type="button" class="quiz-scelta" data-piano={j}>{r}</button>
              ))}
            </div>
          </fieldset>
        ))}
        <div class="quiz-esito" hidden aria-live="polite">
          <p class="mono quiz-n">Il tuo profilo · indicativo</p>
          <ul class="quiz-barre" role="list">
            {piani.map((p) => (
              <li class={`p-${p.id}`}><span class="mono">{p.nome}</span><span class="quiz-bar"><span data-bar={p.id}></span></span></li>
            ))}
          </ul>
          <p class="h3 quiz-titolo-esito"></p>
          <p class="muted" data-quiz-esercizio></p>
          <div class="quiz-azioni">
            <a class="btn btn-primario" href="/contatti" data-cta>Prenota il primo colloquio</a>
            <button type="button" class="btn btn-secondario" data-quiz-reset>Rifai</button>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* SUL CAMPO: tornerà quando ci saranno le foto vere (vedi DA-CONFERMARE.md) */}

  <!-- 10 · DOMANDE -->
  <section class="sezione faq-sezione" data-theme="carta" aria-labelledby="faq-titolo">
    <div class="wrap faq-grid">
      <div class="sezione-head">
        <p class="eyebrow" data-reveal>Domande</p>
        <h2 id="faq-titolo" data-reveal>Hai dei dubbi? È normale.</h2>
        <p class="lead" data-reveal>Qui trovi le risposte alle domande più comuni. Se la tua non c'è, <a href="/contatti">scrivimi</a>: ti rispondo io.</p>
      </div>
      <div class="faq">
        {faq.map((f) => (
          <details class="faq-voce" data-reveal>
            <summary><span>{f.q}</span><span class="faq-segno" aria-hidden="true"></span></summary>
            <p class="muted">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CHI SEI: la scelta del percorso, a fine pagina -->
  <section class="sezione porte-sezione" data-theme="carta" aria-labelledby="porte-titolo" id="porte">
    <div class="wrap">
      <div class="sezione-head">
        <p class="eyebrow" data-reveal>Da dove partiamo?</p>
        <h2 id="porte-titolo" data-reveal>Scegli quello che ti somiglia.</h2>
        <p class="lead" data-reveal>Ti porto alle informazioni giuste per te.</p>
      </div>
      <div class="porte" role="group" aria-label="Scegli il tuo profilo">
        {porte.map((p, i) => (
          <button class="porta" type="button" data-porta={p.id} aria-pressed="false" data-reveal style={`--d:${i * 0.06}s`}>
            <span class="porta-icona" aria-hidden="true"><svg viewBox="0 0 24 24"><path d={icone[p.id]} /></svg></span>
            <span class="porta-nome">{p.porta}</span>
            <span class="porta-sotto mono">{p.sotto}</span>
            <span class="porta-freccia" aria-hidden="true">→</span>
          </button>
        ))}
      </div>
      <div class="porta-esito" aria-live="polite" hidden>
        <p class="porta-riga"></p>
        <a class="link-freccia porta-link" href="#">Vai al percorso <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <!-- 11 · CHIUSURA -->
  <section class="sezione chiusura" data-theme="carta" data-stato="chiusura" aria-labelledby="chiusura-titolo">
    <div class="wrap chiusura-grid">
      <div class="chiusura-ancora" data-ancora aria-hidden="true"></div>
      <div class="chiusura-testo">
        <h2 id="chiusura-titolo" data-reveal>Il primo passo è una chiacchierata.</h2>
        <p class="lead" data-reveal>20 minuti al telefono o in video: mi racconti cosa ti succede, io ti dico se e come posso aiutarti.</p>
        <div class="chiusura-azioni" data-reveal>
          <a class="btn btn-primario" href="/contatti" data-cta>Prenota il primo colloquio</a>
          <a class="btn btn-secondario" href={`https://wa.me/${contatti.whatsapp}`} target="_blank" rel="noopener">Scrivimi su WhatsApp</a>
        </div>
        <p class="rassicura" data-reveal><span>Risposta entro un giorno lavorativo</span><span>Montecatini Terme o online</span><span>Segreto professionale</span></p>
      </div>
    </div>
  </section>
</Base>

<script>
  import '../scripts/home.js';
</script>

<style>
  /* ---------- COLORI DEI PIANI (classi condivise) ---------- */
  .p-pensiero { --c: var(--pensiero); }
  .p-emozione { --c: var(--emozione); }
  .p-corpo { --c: var(--corpo); }
  .p-fisiologia { --c: var(--fisiologia); }
  .evidenza { color: var(--terracotta); }

  /* ---------- HERO ---------- */
  .hero { padding-top: clamp(6.5rem, 12vw, 8.5rem); padding-bottom: clamp(3rem, 7vw, 5rem); overflow: hidden; }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr); align-items: center; gap: clamp(2rem, 5vw, 4rem); }
  .hero-testo { display: grid; gap: 1.4rem; min-width: 0; }
  .hero h1 { max-width: 11ch; }
  .hero-chi { display: grid; gap: .3rem; }
  .hero-ruolo { font-size: .74rem; letter-spacing: .14em; text-transform: uppercase; color: var(--terracotta); font-weight: 600; }
  .hero-cred { margin-top: .15rem; }
  .a-capo { display: block; }
  .piani-pill { display: flex; flex-wrap: wrap; gap: .5rem; margin: -.4rem 0 0; padding: 0; list-style: none; }
  .pill { display: inline-flex; align-items: center; gap: .5rem; padding: .45rem .85rem; border-radius: 999px; font-family: var(--f-display); font-weight: 600; font-size: .92rem; color: var(--inchiostro); background: #fff; border: 1px solid var(--linea); }
  .pill-punto { width: 8px; height: 8px; border-radius: 50%; background: var(--c); }
  .hero-cta { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: .25rem; }
  .fiducia { font-size: .72rem; letter-spacing: .06em; color: var(--fg-2); max-width: 46ch; }

  .hero-foto { position: relative; width: min(100%, 440px); justify-self: center; padding: 1.5rem; }
  .hero-foto :global(.foto-hero) { position: relative; z-index: 1; border-radius: 999px 999px 26px 26px; box-shadow: 0 40px 80px -36px rgba(11, 18, 48, .55); }
  .aurora { position: absolute; inset: -10%; z-index: 0; filter: blur(60px); opacity: .45; }
  .aurora span { position: absolute; width: 58%; aspect-ratio: 1; border-radius: 50%; animation: deriva 18s var(--respiro) infinite alternate; }
  .aurora .b1 { background: #7C93FF; left: 0; top: 4%; }
  .aurora .b2 { background: #C9D3FF; right: 0; top: 0; animation-delay: -4s; }
  .aurora .b3 { background: #DCE3F5; left: 6%; bottom: 0; animation-delay: -9s; }
  .aurora .b4 { background: #A9B8F5; right: 2%; bottom: 6%; animation-delay: -13s; }
  @keyframes deriva { 0% { transform: translate(0, 0) scale(1); } 50% { transform: translate(6%, -5%) scale(1.08); } 100% { transform: translate(-5%, 6%) scale(.95); } }
  
  

  @media (max-width: 860px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-foto { order: -1; width: min(68vw, 290px); padding: .75rem; }
    .hero-cta .btn { flex: 1 1 auto; }
  }

  /* ---------- LA SFERA ---------- */
  .mente { background: var(--bg); }
  .mente-grid { display: grid; grid-template-columns: minmax(0, .95fr) minmax(0, 1.05fr); grid-template-areas: 'testo stage' 'legenda stage'; gap: 1.4rem clamp(2rem, 5vw, 4rem); align-items: center; }
  .mente-testo { grid-area: testo; align-self: end; }
  .mente-stage { grid-area: stage; }
  .mente-legenda { grid-area: legenda; align-self: start; display: grid; gap: 1.4rem; }
  .mente-testo { display: grid; gap: 1.4rem; min-width: 0; }
  .mente-testo .lead { max-width: 40ch; }
  .mente-testo strong { color: var(--inchiostro); }
  .hint-touch { display: none; }
  @media (pointer: coarse) { .hint-fine { display: none; } .hint-touch { display: inline; } }
  .legenda { display: grid; gap: .65rem; margin: 0; padding: 0; list-style: none; }
  .legenda li { display: grid; grid-template-columns: auto 1fr; gap: .75rem; align-items: baseline; padding: .7rem 0; border-bottom: 1px solid var(--linea); }
  .legenda strong { color: var(--inchiostro); font-family: var(--f-display); }
  .legenda-punto { width: 10px; height: 10px; border-radius: 50%; background: var(--c); transform: translateY(1px); }
  .mente-sintesi { font-family: var(--f-display); font-weight: 600; font-size: clamp(1.2rem, 1rem + .8vw, 1.6rem); letter-spacing: -0.02em; line-height: 1.2; }
  .mente-stage { display: grid; gap: 1rem; touch-action: pan-y; min-width: 0; }
  .mente-ancora { position: relative; aspect-ratio: 1; width: min(100%, 520px); justify-self: center; }
  .angolo { position: absolute; display: inline-flex; align-items: center; gap: .4rem; font-family: var(--f-display); font-weight: 600; font-size: .85rem; color: var(--inchiostro); padding: .3rem .7rem; border-radius: 999px; background: #fff; border: 1px solid var(--linea); }
  .angolo::before { content: ''; width: 8px; height: 8px; border-radius: 50%; background: var(--c); }
  .a1 { left: 0; top: 4%; } .a2 { right: 0; top: 4%; } .a3 { left: 0; bottom: 4%; } .a4 { right: 0; bottom: 4%; }
  .tieni { position: relative; overflow: hidden; justify-self: center; width: min(100%, 360px); min-height: 4.2rem; padding: .7rem 1.5rem; border: 0; border-radius: 999px; background: var(--inchiostro); color: #fff; display: grid; place-items: center; gap: .1rem; cursor: pointer; user-select: none; -webkit-user-select: none; -webkit-touch-callout: none; touch-action: none; -webkit-tap-highlight-color: transparent; transition: transform .4s var(--respiro); }
  .tieni.premuto { transform: scale(.97); }
  /* il pulsante serve solo sui dispositivi touch: su PC basta il cursore */
  @media (hover: hover) and (pointer: fine) { .tieni { display: none; } }
  .tieni-riempi { position: absolute; inset: 0; background: var(--terracotta); transform-origin: left; transform: scaleX(var(--p, 0)); }
  .tieni-testo { position: relative; font-family: var(--f-display); font-weight: 600; font-size: 1.1rem; letter-spacing: -0.01em; }
  .tieni-sotto { position: relative; font-size: .62rem; letter-spacing: .12em; text-transform: uppercase; opacity: .75; }
  .pressometro { display: grid; grid-template-columns: auto 1fr 4ch; align-items: center; gap: .9rem; font-size: .72rem; letter-spacing: .1em; text-transform: uppercase; color: var(--fg-2); }
  .pressometro-barra { height: 8px; border-radius: 8px; background: color-mix(in srgb, var(--inchiostro) 8%, transparent); overflow: hidden; }
  .pressometro-barra span { display: block; height: 100%; width: 100%; border-radius: 8px; background: var(--terracotta); transform-origin: left; transform: scaleX(.02); }
  .pressometro-val { text-align: right; color: var(--inchiostro); font-weight: 600; }
  .telemetria { width: 100%; }
  .tel-testa { display: flex; justify-content: space-between; font-size: .72rem; letter-spacing: .08em; color: var(--fg-2); text-transform: uppercase; }
  .tel-live { display: inline-flex; align-items: center; gap: .5rem; }
  .tel-punto { width: 6px; height: 6px; border-radius: 50%; background: var(--terracotta); animation: spia 1s var(--respiro) infinite; }
  .tel-bpm { color: var(--inchiostro); font-weight: 600; }
  .tel-svg { width: 100%; height: clamp(50px, 7vw, 80px); overflow: visible; margin-top: .4rem; }
  .tel-asse { stroke: var(--linea); stroke-width: 1; vector-effect: non-scaling-stroke; stroke-dasharray: 2 6; }
  .tel-linea { fill: none; stroke: var(--inchiostro); stroke-width: 2; vector-effect: non-scaling-stroke; stroke-linejoin: round; }
  .tel-msg { min-height: 1.6em; font-size: .78rem; letter-spacing: .04em; color: var(--fg-2); margin-top: .4rem; }
  .tel-msg.calma { color: var(--terracotta); font-weight: 600; }
  @media (max-width: 860px) {
    .mente-grid { grid-template-columns: 1fr; grid-template-areas: 'testo' 'stage' 'legenda'; }
    .legenda { grid-template-columns: 1fr 1fr; }
    .legenda li { grid-template-columns: auto 1fr; padding: .6rem .7rem; }
    .legenda .muted { display: none; }
    .mente-ancora { width: min(88vw, 400px); }
  }

  /* ---------- PORTE ---------- */
  .porte { display: grid; grid-template-columns: repeat(5, 1fr); gap: .75rem; }
  .porta {
    position: relative; display: grid; align-content: space-between; gap: 2.5rem; text-align: left;
    min-height: 13rem; padding: 1.25rem; border-radius: var(--radius);
    border: 1px solid var(--line); background: color-mix(in srgb, var(--carta) 75%, transparent);
    transition: border-color .5s var(--respiro), background-color .5s var(--respiro), transform .6s var(--respiro);
  }
  .porta:hover { border-color: var(--inchiostro); transform: translateY(-3px); }
  .porta[aria-pressed="true"] { background: var(--inchiostro); color: #fff; border-color: var(--inchiostro); }
  .porta[aria-pressed="true"] .porta-sotto { color: rgba(255, 255, 255, .75); }
  .porta-icona { width: 2.6rem; height: 2.6rem; border-radius: 12px; display: grid; place-items: center; background: color-mix(in srgb, var(--terracotta) 9%, #fff); }
  .porta-icona svg { width: 1.3rem; height: 1.3rem; fill: none; stroke: var(--terracotta); stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .porta[aria-pressed="true"] .porta-icona { background: rgba(255, 255, 255, .14); }
  .porta[aria-pressed="true"] .porta-icona svg { stroke: #fff; }
  .porta::after { content: ''; position: absolute; left: 1.25rem; right: 1.25rem; top: 0; height: 3px; border-radius: 0 0 3px 3px; background: var(--terracotta); transform: scaleX(0); transition: transform .6s var(--respiro); }
  .porta:hover::after, .porta[aria-pressed="true"]::after { transform: scaleX(1); }
  .porta-nome { font-family: var(--f-display); font-weight: 600; font-size: clamp(1.25rem, 1rem + .7vw, 1.55rem); letter-spacing: -0.02em; line-height: 1.1; align-self: end; }
  .porta-sotto { font-size: .68rem; letter-spacing: .12em; text-transform: uppercase; color: var(--fg-2); }
  .porta-freccia { position: absolute; right: 1.25rem; top: 1.1rem; transition: transform .6s var(--respiro); }
  .porta:hover .porta-freccia { transform: translateX(4px); }
  .porta-esito { margin-top: 1.5rem; display: flex; flex-wrap: wrap; align-items: baseline; gap: .5rem 1.5rem; padding: 1.25rem 1.5rem; border-radius: var(--radius); background: var(--carta-2); }
  .porta-riga { font-size: 1.05rem; max-width: 60ch; }
  @media (max-width: 980px) {
    .porte { grid-template-columns: 1fr; gap: .5rem; }
    .porta { min-height: 0; grid-template-columns: auto 1fr auto; align-items: center; gap: 1rem; padding: 1.05rem 1.1rem; }
    .porta-nome { align-self: center; }
    .porta-sotto { display: none; }
    .porta-freccia { position: static; }
  }

  /* ---------- AUTORITÀ + NUMERI ---------- */
  .autorita-sezione { padding-top: clamp(2.5rem, 6vh, 4rem); }
  .nastro { overflow: hidden; border-block: 1px solid var(--linea); padding: 1.1rem 0; mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent); position: relative; z-index: 2; }
  .nastro-scorre { display: flex; gap: 3.5rem; width: max-content; animation: nastro 48s linear infinite; font-size: .8rem; letter-spacing: .12em; text-transform: uppercase; color: var(--grafite); }
  .nastro-scorre span::before { content: '◆'; margin-right: 3.5rem; color: var(--terracotta); font-size: .55rem; vertical-align: middle; }
  .nastro:hover .nastro-scorre { animation-play-state: paused; }
  @keyframes nastro { to { transform: translateX(-50%); } }
  .numeri { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; margin-top: clamp(3rem, 7vw, 5rem); }
  .numero { display: grid; gap: .75rem; padding-top: 1.25rem; border-top: 1px solid var(--inchiostro); }
  .numero-val { font-size: clamp(3rem, 2rem + 4vw, 5.5rem); line-height: .9; font-weight: 600; letter-spacing: -0.05em; font-variant-numeric: tabular-nums; }
  .numero-lab { color: var(--fg-2); max-width: 18ch; }
  @media (max-width: 820px) { .numeri { grid-template-columns: 1fr 1fr; gap: 2rem 1rem; } }

  /* ---------- RESPIRO ---------- */
  .respiro-grid { display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: 3rem; }
  .respiro-testo { display: grid; gap: 1.5rem; }
  .respiro-azioni { display: flex; gap: .75rem; flex-wrap: wrap; }
  .respiro-fine { display: grid; gap: .75rem; padding: 1.25rem 1.5rem; border-left: 3px solid var(--terracotta); }
  .respiro-stage { position: relative; aspect-ratio: 1; width: min(100%, 520px); justify-self: center; display: grid; place-items: center; }
  .respiro-anello { position: absolute; inset: 0; width: 100%; height: 100%; transform: rotate(-90deg); }
  .anello-guida { fill: none; stroke: var(--linea); stroke-width: 1; vector-effect: non-scaling-stroke; }
  .anello-progresso { fill: none; stroke: var(--terracotta); stroke-width: 2; vector-effect: non-scaling-stroke; stroke-dasharray: 1; stroke-dashoffset: 1; stroke-linecap: round; }
  .respiro-centro { position: relative; text-align: center; display: grid; gap: .35rem; padding: 1rem 1.5rem; border-radius: 999px; background: color-mix(in srgb, var(--carta) 72%, transparent); backdrop-filter: blur(4px); -webkit-backdrop-filter: blur(4px); }
  .respiro-fase { font-size: clamp(1.6rem, 1.2rem + 1.6vw, 2.4rem); font-weight: 600; letter-spacing: -0.03em; }
  .respiro-conto { font-size: .8rem; color: var(--fg-2); letter-spacing: .1em; }
  @media (max-width: 820px) {
    .respiro-grid { grid-template-columns: 1fr; gap: 2rem; }
    .respiro-stage { width: min(84vw, 420px); order: 2; }
  }

  /* ---------- CRUSCOTTO ---------- */
  .cruscotto-layout { display: grid; gap: 1.25rem; }
  .cruscotto-head { margin-bottom: 1rem; }
  .cruscotto-chiusa { display: grid; gap: .9rem; margin-top: 1rem; justify-items: center; }
  @media (min-width: 1024px) {
    .cruscotto-layout {
      grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr);
      grid-template-areas: 'head griglia' 'pressione griglia' 'dettaglio griglia' 'chiusa griglia';
      grid-template-rows: auto auto auto 1fr; column-gap: clamp(2rem, 5vw, 5rem); row-gap: .75rem; align-items: start;
    }
    .cruscotto-head { grid-area: head; margin-bottom: .5rem; }
    .cruscotto-grid { grid-area: griglia; align-self: center; }
    .pressione { grid-area: pressione; margin: 0 !important; max-width: none !important; }
    .cruscotto-dettaglio { grid-area: dettaglio; text-align: left !important; margin: 0 !important; }
    .cruscotto-chiusa { grid-area: chiusa; margin-top: .5rem; justify-items: start; }
    .cruscotto-chiusa .h3 { text-align: left !important; }
    .cruscotto-ancora { width: min(100%, 34vh) !important; justify-self: center; }
    .strumento { padding: .9rem .75rem .75rem !important; }
    .strumento svg { max-width: min(150px, 15vh) !important; }
  }
  .cruscotto-grid {
    display: grid; grid-template-columns: 1fr minmax(0, 1.3fr) 1fr; grid-template-rows: auto auto;
    grid-template-areas: 's1 ancora s2' 's3 ancora s4'; gap: 1rem 2rem; align-items: center;
  }
  .s1 { grid-area: s1; } .s2 { grid-area: s2; } .s3 { grid-area: s3; } .s4 { grid-area: s4; }
  .cruscotto-ancora { grid-area: ancora; aspect-ratio: 1; width: 100%; }
  .strumento {
    display: grid; justify-items: center; gap: .35rem; padding: 1.25rem 1rem 1rem; border-radius: var(--radius);
    border: 1px solid var(--linea-scura); background: color-mix(in srgb, var(--cruscotto-2) 70%, transparent);
    color: var(--testo-scuro); transition: border-color .5s var(--respiro), background-color .5s var(--respiro);
  }
  .strumento:hover, .strumento[aria-expanded="true"] { border-color: var(--c); }
  .strumento svg { width: 100%; max-width: 180px; overflow: visible; }
  .arco-base { fill: none; stroke: var(--linea-scura); stroke-width: 7; stroke-linecap: round; }
  .arco-val { fill: none; stroke: var(--c, var(--telemetria)); stroke-width: 7; stroke-linecap: round; stroke-dasharray: 100; stroke-dashoffset: 100; transition: stroke .4s var(--respiro); }
  .strumento.alto { box-shadow: inset 0 0 0 1px var(--c), 0 0 32px -10px var(--c); }
  .strumento-nome::before { content: ''; display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: var(--c); margin-right: .45rem; transform: translateY(-1px); }
  .lancetta { stroke: var(--testo-scuro); stroke-width: 2; stroke-linecap: round; transform-origin: 60px 62px; }
  .perno { fill: var(--testo-scuro); }
  .strumento-nome { font-family: var(--f-display); font-weight: 600; font-size: 1.15rem; letter-spacing: -0.02em; }
  .strumento-val { font-size: .8rem; color: var(--testo-scuro-2); letter-spacing: .06em; font-variant-numeric: tabular-nums; }

  .pressione { display: grid; grid-template-columns: auto 1fr 3ch; align-items: center; gap: 1rem; max-width: 640px; margin: 2.5rem auto 0; }
  .pressione-lab { font-size: .75rem; letter-spacing: .16em; text-transform: uppercase; color: var(--testo-scuro-2); }
  .pressione-out { text-align: right; color: var(--segnale); font-weight: 600; }
  .pressione input { appearance: none; -webkit-appearance: none; width: 100%; height: 2.75rem; background: transparent; cursor: pointer; }
  .pressione input::-webkit-slider-runnable-track { height: 4px; border-radius: 4px; background: linear-gradient(90deg, var(--telemetria), var(--segnale)); }
  .pressione input::-moz-range-track { height: 4px; border-radius: 4px; background: linear-gradient(90deg, var(--telemetria), var(--segnale)); }
  .pressione input::-webkit-slider-thumb { -webkit-appearance: none; width: 26px; height: 26px; border-radius: 50%; margin-top: -11px; background: var(--testo-scuro); border: 5px solid var(--cruscotto); box-shadow: 0 0 0 1px var(--testo-scuro); }
  .pressione input::-moz-range-thumb { width: 18px; height: 18px; border-radius: 50%; background: var(--testo-scuro); border: 5px solid var(--cruscotto); }
  .cruscotto-dettaglio { text-align: center; max-width: 46ch; margin: 1.5rem auto 0; color: var(--testo-scuro-2); min-height: 3.2em; }
  .cruscotto-chiusa .h3 { text-align: center; }
  .accento { color: var(--segnale); }
  @media (max-width: 820px) {
    .cruscotto-grid { grid-template-columns: 1fr 1fr; grid-template-areas: 'ancora ancora' 's1 s2' 's3 s4'; gap: .75rem; }
    .cruscotto-ancora { width: min(76vw, 360px); margin-inline: auto; }
    .strumento { padding: 1rem .75rem .85rem; }
    .pressione { grid-template-columns: 1fr 3ch; }
    .pressione-lab { grid-column: 1 / -1; }
  }

  /* ---------- PISTA ---------- */
  .pista { padding-block: 0; }
  .pista-ancora { position: sticky; top: 9svh; height: 34svh; width: 42%; margin-left: auto; margin-right: 5%; margin-bottom: -34svh; z-index: 0; pointer-events: none; }
  .pista-stage { min-height: 100svh; display: grid; grid-template-columns: minmax(0, 1fr); align-content: center; gap: clamp(2rem, 5vw, 3.5rem); padding-block: clamp(5rem, 10vw, 7rem); overflow: hidden; }
  .pista-head { display: grid; gap: 1rem; }
  .pista-progresso { display: flex; align-items: center; gap: 1rem; font-size: .8rem; color: var(--testo-scuro-2); letter-spacing: .1em; }
  .pista-progresso .barra { width: 140px; height: 2px; background: var(--linea-scura); position: relative; }
  .pista-progresso .barra span { position: absolute; inset: 0; background: var(--segnale); transform-origin: left; transform: scaleX(var(--p, 0)); }
  .pista-binario { position: relative; min-width: 0; }
  .pista-tappe { display: flex; gap: clamp(1rem, 3vw, 2rem); padding-inline: max(var(--gutter), calc((100vw - var(--max)) / 2)); width: max-content; }
  .tappa { width: min(78vw, 360px); display: grid; gap: .9rem; align-content: start; padding: 1.5rem; border-radius: var(--radius); border: 1px solid var(--linea-scura); background: color-mix(in srgb, var(--cruscotto) 88%, transparent); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); }
  .tappa-quando { font-size: .75rem; letter-spacing: .12em; color: var(--segnale); text-transform: uppercase; }
  .pista-traccia { width: 100%; height: 90px; margin-top: 2rem; overflow: visible; }
  .traccia-base { fill: none; stroke: var(--linea-scura); stroke-width: 1; vector-effect: non-scaling-stroke; }
  .traccia-viva { fill: none; stroke: var(--telemetria); stroke-width: 2; vector-effect: non-scaling-stroke; stroke-dasharray: 1; stroke-dashoffset: 1; }
  @media (max-width: 820px) {
    .pista-stage { overflow: visible; }
    .pista-ancora { width: 100%; margin: 0 0 -30svh; top: 12svh; height: 30svh; }
    .pista-tappe { flex-direction: column; width: auto; padding-inline: var(--gutter); }
    .tappa { width: auto; }
    .pista-traccia { display: none; }
    .pista-progresso { position: sticky; top: 5rem; }
  }

  /* ---------- GIRI ---------- */
  .giri { display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(1.25rem, 3vw, 2.5rem); margin: 0; padding: 0; list-style: none; }
  .giro { display: grid; gap: .9rem; align-content: start; padding-top: 1.25rem; border-top: 2px solid var(--linea); }
  .giro:last-child { border-top-color: var(--terracotta); }
  .giro-n { font-family: var(--f-display); font-weight: 700; font-size: clamp(2rem, 1.4rem + 1.6vw, 3rem); line-height: 1; letter-spacing: -0.04em; color: var(--terracotta); }
  .giro-testo { display: grid; gap: .45rem; }
  @media (max-width: 820px) {
    .giri { grid-template-columns: 1fr; gap: 0; }
    .giro { grid-template-columns: 3.2rem 1fr; gap: 1rem; align-items: baseline; padding: .8rem 0; border-top: 1px solid var(--linea); }
    .giro:last-child { border-bottom: 1px solid var(--linea); border-top-color: var(--linea); }
    .giro-n { font-size: 1.9rem; }
  }

  /* ---------- QUIZ ---------- */
  .quiz-grid { display: grid; grid-template-columns: 1fr 1.2fr; gap: 3rem; align-items: start; }
  .quiz { position: relative; overflow: hidden; padding-top: 2rem; min-height: 22rem; }
  .quiz-barra { position: absolute; top: 0; left: 0; right: 0; height: 3px; background: var(--linea); }
  .quiz-barra span { display: block; height: 100%; background: var(--terracotta); transform-origin: left; transform: scaleX(var(--p, 0)); transition: transform .6s var(--respiro); }
  .quiz-domanda { border: 0; padding: 0; margin: 0; }
  .quiz-domanda legend { padding: 0; margin-bottom: 1.25rem; }
  .quiz-n { font-size: .72rem; letter-spacing: .12em; color: var(--fg-2); margin-right: .35rem; vertical-align: middle; }
  .quiz-scelte { display: grid; gap: .5rem; }
  .quiz-scelta { text-align: left; padding: .95rem 1.1rem; border-radius: 14px; border: 1px solid var(--linea); background: var(--carta); transition: border-color .4s var(--respiro), background-color .4s var(--respiro); min-height: 44px; }
  .quiz-scelta:hover { border-color: var(--inchiostro); }
  .quiz-scelta:active { background: var(--carta-2); }
  .quiz-esito { display: grid; gap: 1rem; }
  .quiz-barre { display: grid; gap: .65rem; }
  .quiz-barre li { display: grid; grid-template-columns: 7rem 1fr; align-items: center; gap: 1rem; font-size: .8rem; }
  .quiz-bar { height: 8px; border-radius: 8px; background: var(--linea); overflow: hidden; }
  .quiz-bar span { display: block; height: 100%; background: var(--c, var(--inchiostro)); border-radius: 8px; transform-origin: left; transform: scaleX(0); transition: transform 1s var(--respiro); }
  .quiz-bar span.top { box-shadow: 0 0 0 2px color-mix(in srgb, var(--c) 30%, transparent); }
  .quiz-barre li span.mono { color: var(--c); font-weight: 600; }
  .quiz-azioni { display: flex; gap: .75rem; flex-wrap: wrap; margin-top: .5rem; }
  @media (max-width: 860px) { .quiz-grid { grid-template-columns: 1fr; gap: 0; } }

  /* ---------- SUL CAMPO ---------- */
  .galleria { display: grid; grid-template-columns: 1fr 1.4fr 1.4fr; grid-template-rows: auto auto; gap: 1rem; }
  .galleria :global(.g1) { grid-row: span 2; }
  .galleria :global(.g4) { grid-column: span 2; aspect-ratio: 21 / 9; }
  @media (max-width: 860px) {
    .galleria { grid-template-columns: 1fr; }
    .galleria :global(.g1) { grid-row: auto; }
