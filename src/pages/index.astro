    .cruscotto .lead { font-size: .95rem; }
    .cruscotto-chiusa { margin-top: 0; gap: .4rem; }
    .cruscotto-chiusa .h3 { font-size: 1.1rem; }

    /* Pista: le tappe scorrono di lato */
    .pista-stage { min-height: 100svh; padding-block: 2.5rem; gap: 1.25rem; align-content: center; }
    .pista-progresso { position: static; }
    .pista-binario { padding-bottom: .75rem; }
    .pista-tappe { flex-direction: row; width: max-content; padding-inline: 0; gap: .75rem; }
    .tappa { width: 80vw; scroll-snap-align: start; padding: 1.15rem; }
    .pista-ancora { position: absolute; top: 2rem; right: 0; width: 70%; height: 26svh; margin: 0; }

    /* Come lavoro */
    .giri-sezione { min-height: 100svh; display: grid; align-content: center; }
    .giro h3 { font-size: 1.15rem; }
    .giro .muted { font-size: .92rem; line-height: 1.45; }

    /* Autovalutazione */
    .quiz-sezione { min-height: 100svh; display: grid; align-content: center; }
    .quiz { min-height: 0; padding-top: 1.25rem; }
    .quiz-domanda legend { margin-bottom: .75rem; }
    .quiz-scelta { padding: .7rem .95rem; }

    /* Sul campo e media: schede che scorrono */
    .campo-sezione, .media-sezione, .faq-sezione { min-height: 100svh; display: grid; align-content: center; }
    .galleria > :global(*) { flex: 0 0 76vw; height: 44svh; aspect-ratio: auto !important; scroll-snap-align: start; }
    .media-sezione .griglia-3 > li { flex: 0 0 78vw; scroll-snap-align: start; }
    .faq-voce summary { padding: 1rem 0; font-size: 1rem; }
  }
  /* pulsante "Tieni premuto": compatto, a pillola */
  .tieni { width: auto; min-height: 3.1rem; padding: .55rem 1.5rem .55rem 1.05rem; display: inline-flex; align-items: center; gap: .65rem; place-items: initial; }
  .tieni-dito { position: relative; left: auto; top: auto; margin: 0; width: 1.45rem; height: 1.45rem; flex: none; }
  .tieni-testo { font-size: 1rem; }
  .tieni::after { inset: -5px; }
  @media (hover: hover) and (pointer: fine) { .tieni { display: none; } }
  /* cruscotto: verde al centro, rosso agli estremi */
  .defs-cruscotto { position: absolute; width: 0; height: 0; overflow: hidden; }
  .arco-base { stroke: var(--linea-scura); stroke-width: 9; }
  .arco-zone { fill: none; stroke: url(#zone-equilibrio); stroke-width: 5; stroke-linecap: round; opacity: .9; }
  .arco-val { display: none; }
  .lancetta { stroke: var(--stato, var(--testo-scuro)); stroke-width: 3; transition: transform .35s var(--uscita), stroke .35s; }
  .perno { fill: var(--stato, var(--testo-scuro)); transition: fill .35s; }
  .strumento { --stato: hsl(178 90% 58%); --bagliore: 0; border-color: color-mix(in srgb, var(--stato) 75%, transparent) !important; box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--stato) calc(var(--bagliore) * 100%), transparent), 0 0 calc(10px + var(--bagliore) * 34px) -10px var(--stato); transition: border-color .3s, box-shadow .3s, background-color .35s; }
  .strumento .strumento-val { color: var(--stato); font-weight: 600; transition: color .35s; }
  .strumento[aria-pressed="true"] { border-width: 2px; background: color-mix(in srgb, var(--testo-scuro) 9%, var(--cruscotto-2)); }
  .strumento[aria-pressed="true"] .strumento-nome { text-decoration: underline; text-underline-offset: .3em; text-decoration-thickness: 2px; }
  .pressione { grid-template-columns: minmax(0, 1fr) 10.5rem; row-gap: .4rem; }
  .pressione-lab { grid-column: 1 / -1; }
  .pressione-out { min-width: 0; }
  .strumento-val { font-family: var(--f-text) !important; letter-spacing: 0 !important; font-size: .78rem !important; line-height: 1.2; text-align: center; }
  @media (max-width: 820px) { .pressione { grid-template-columns: minmax(0, 1fr) 8.5rem; } .strumento-val { font-size: .85rem !important; } }
  .pressione input::-webkit-slider-runnable-track { height: 8px; border-radius: 8px; background: linear-gradient(90deg, #FF4D4F, #FF8A3D 14%, #FFD23F 30%, #8BE38B 42%, #2EE6D6 50%, #8BE38B 58%, #FFD23F 70%, #FF8A3D 86%, #FF4D4F); }
  .pressione input::-moz-range-track { height: 8px; border-radius: 8px; background: linear-gradient(90deg, #FF4D4F, #FF8A3D 14%, #FFD23F 30%, #8BE38B 42%, #2EE6D6 50%, #8BE38B 58%, #FFD23F 70%, #FF8A3D 86%, #FF4D4F); }
  .pressione input::-webkit-slider-thumb { margin-top: -9px; }
  .pressione-out { color: var(--stato-sel, var(--telemetria)); min-width: 9ch; text-align: right; transition: color .35s; }
  .pressione-reset { grid-column: 1 / -1; justify-self: center; border: 0; background: none; color: var(--testo-scuro-2); font-size: .7rem; letter-spacing: .1em; text-transform: uppercase; text-decoration: underline; text-underline-offset: .3em; cursor: pointer; padding: .3rem; }
  .pressione-reset:hover { color: var(--testo-scuro); }
  .cruscotto-dettaglio.equilibrio { color: var(--telemetria); }
  .cruscotto-dettaglio.allarme { color: #FF8A8E; }
  /* istruzioni nel testo: le parole "fanno" quello che dicono */
  .mente .evidenziatore.hint-fine { display: inline-block; }
  .mente .evidenziatore.hint-touch { display: none; }
  @media (pointer: coarse) { .mente .evidenziatore.hint-fine { display: none; } .mente .evidenziatore.hint-touch { display: inline-block; } }
  .mente.vista:not(.provato) .hint-fine.evidenziatore:not(.e2) { animation: parola-veloce 3.6s var(--respiro) 1.4s infinite; }
  .mente.vista:not(.provato) .hint-fine.e2 { animation: parola-ferma 3.6s var(--respiro) 1.4s infinite; }
  .mente.vista:not(.provato) .hint-touch.evidenziatore:not(.e2) { animation: parola-preme 3.2s var(--respiro) 1.4s infinite; }
  .mente.vista:not(.provato) .hint-touch.e2 { animation: parola-lascia 3.2s var(--respiro) 1.4s infinite; }
  @keyframes parola-veloce {
    0%, 36%, 100% { transform: none; text-shadow: none; }
    4% { transform: translateX(-5px) skewX(-8deg); text-shadow: 6px 0 0 rgba(36, 67, 214, .25), 12px 0 0 rgba(36, 67, 214, .12); }
