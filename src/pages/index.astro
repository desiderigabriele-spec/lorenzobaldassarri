    color: var(--testo-scuro); transition: border-color .5s var(--respiro), background-color .5s var(--respiro);
  }
  .strumento:hover, .strumento[aria-expanded="true"] { border-color: var(--c); }
  .strumento svg { width: 100%; max-width: 180px; overflow: visible; }
  .arco-base { fill: none; stroke: var(--linea-scura); stroke-width: 7; stroke-linecap: round; }
  .arco-val { fill: none; stroke: var(--c, var(--telemetria)); stroke-width: 7; stroke-linecap: round; stroke-dasharray: 100; stroke-dashoffset: 100; transition: stroke .4s var(--respiro); }
  .strumento.alto { box-shadow: inset 0 0 0 1px var(--c), 0 0 32px -10px var(--c); }
  .strumento-nome::before { content: ''; display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: var(--c); margin-right: .45rem; transform: translateY(-1px); }
  .lancetta { stroke: var(--testo-scuro); stroke-width: 2; stroke-linecap: round; transform-origin: 60px 62px; }
  .perno { fill: var(--testo-scuro); }
  .strumento-nome { font-family: var(--f-display); font-weight: 600; font-size: 1.15rem; letter-spacing: -0.02em; }
  .strumento-val { font-size: .8rem; color: var(--testo-scuro-2); letter-spacing: .06em; font-variant-numeric: tabular-nums; }

  .pressione { display: grid; grid-template-columns: auto 1fr 3ch; align-items: center; gap: 1rem; max-width: 640px; margin: 2.5rem auto 0; }
  .pressione-lab { font-size: .75rem; letter-spacing: .16em; text-transform: uppercase; color: var(--testo-scuro-2); }
  .pressione-out { text-align: right; color: var(--segnale); font-weight: 600; }
  .pressione input { appearance: none; -webkit-appearance: none; width: 100%; height: 2.75rem; background: transparent; cursor: pointer; }
  .pressione input::-webkit-slider-runnable-track { height: 4px; border-radius: 4px; background: linear-gradient(90deg, var(--telemetria), var(--segnale)); }
  .pressione input::-moz-range-track { height: 4px; border-radius: 4px; background: linear-gradient(90deg, var(--telemetria), var(--segnale)); }
  .pressione input::-webkit-slider-thumb { -webkit-appearance: none; width: 26px; height: 26px; border-radius: 50%; margin-top: -11px; background: var(--testo-scuro); border: 5px solid var(--cruscotto); box-shadow: 0 0 0 1px var(--testo-scuro); }
  .pressione input::-moz-range-thumb { width: 18px; height: 18px; border-radius: 50%; background: var(--testo-scuro); border: 5px solid var(--cruscotto); }
  .cruscotto-dettaglio { text-align: center; max-width: 46ch; margin: 1.5rem auto 0; color: var(--testo-scuro-2); min-height: 3.2em; }
  .cruscotto-chiusa .h3 { text-align: center; }
  .accento { color: var(--segnale); }
  @media (max-width: 820px) {
    .cruscotto-grid { grid-template-columns: 1fr 1fr; grid-template-areas: 'ancora ancora' 's1 s2' 's3 s4'; gap: .75rem; }
    .cruscotto-ancora { width: min(76vw, 360px); margin-inline: auto; }
    .strumento { padding: 1rem .75rem .85rem; }
    .pressione { grid-template-columns: 1fr 3ch; }
    .pressione-lab { grid-column: 1 / -1; }
  }

  /* ---------- PISTA ---------- */
  .pista { padding-block: 0; }
  .pista-ancora { position: sticky; top: 9svh; height: 34svh; width: 42%; margin-left: auto; margin-right: 5%; margin-bottom: -34svh; z-index: 0; pointer-events: none; }
  .pista-stage { min-height: 100svh; display: grid; grid-template-columns: minmax(0, 1fr); align-content: center; gap: clamp(2rem, 5vw, 3.5rem); padding-block: clamp(5rem, 10vw, 7rem); overflow: hidden; }
  .pista-head { display: grid; gap: 1rem; }
  .pista-progresso { display: flex; align-items: center; gap: 1rem; font-size: .8rem; color: var(--testo-scuro-2); letter-spacing: .1em; }
  .pista-progresso .barra { width: 140px; height: 2px; background: var(--linea-scura); position: relative; }
  .pista-progresso .barra span { position: absolute; inset: 0; background: var(--segnale); transform-origin: left; transform: scaleX(var(--p, 0)); }
  .pista-binario { position: relative; min-width: 0; }
  .pista-tappe { display: flex; gap: clamp(1rem, 3vw, 2rem); padding-inline: max(var(--gutter), calc((100vw - var(--max)) / 2)); width: max-content; }
  .tappa { width: min(78vw, 360px); display: grid; gap: .9rem; align-content: start; padding: 1.5rem; border-radius: var(--radius); border: 1px solid var(--linea-scura); background: color-mix(in srgb, var(--cruscotto) 88%, transparent); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); }
  .tappa-quando { font-size: .75rem; letter-spacing: .12em; color: var(--segnale); text-transform: uppercase; }
  .pista-traccia { width: 100%; height: 90px; margin-top: 2rem; overflow: visible; }
  .traccia-base { fill: none; stroke: var(--linea-scura); stroke-width: 1; vector-effect: non-scaling-stroke; }
  .traccia-viva { fill: none; stroke: var(--telemetria); stroke-width: 2; vector-effect: non-scaling-stroke; stroke-dasharray: 1; stroke-dashoffset: 1; }
  @media (max-width: 820px) {
    .pista-stage { overflow: visible; }
    .pista-ancora { width: 100%; margin: 0 0 -30svh; top: 12svh; height: 30svh; }
    .pista-tappe { flex-direction: column; width: auto; padding-inline: var(--gutter); }
    .tappa { width: auto; }
    .pista-traccia { display: none; }
    .pista-progresso { position: sticky; top: 5rem; }
  }

  /* ---------- GIRI ---------- */
  .giri { display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(1.25rem, 3vw, 2.5rem); margin: 0; padding: 0; list-style: none; }
  .giro { display: grid; gap: .9rem; align-content: start; padding-top: 1.25rem; border-top: 2px solid var(--linea); }
  .giro:last-child { border-top-color: var(--terracotta); }
  .giro-n { font-family: var(--f-display); font-weight: 700; font-size: clamp(2rem, 1.4rem + 1.6vw, 3rem); line-height: 1; letter-spacing: -0.04em; color: var(--terracotta); }
  .giro-testo { display: grid; gap: .45rem; }
  @media (max-width: 820px) {
    .giri { grid-template-columns: 1fr; gap: 0; }
    .giro { grid-template-columns: 3.2rem 1fr; gap: 1rem; align-items: baseline; padding: .8rem 0; border-top: 1px solid var(--linea); }
    .giro:last-child { border-bottom: 1px solid var(--linea); border-top-color: var(--linea); }
    .giro-n { font-size: 1.9rem; }
  }

  /* ---------- QUIZ ---------- */
  .quiz-grid { display: grid; grid-template-columns: 1fr 1.2fr; gap: 3rem; align-items: start; }
  .quiz { position: relative; overflow: hidden; padding-top: 2rem; min-height: 22rem; }
  .quiz-barra { position: absolute; top: 0; left: 0; right: 0; height: 3px; background: var(--linea); }
  .quiz-barra span { display: block; height: 100%; background: var(--terracotta); transform-origin: left; transform: scaleX(var(--p, 0)); transition: transform .6s var(--respiro); }
  .quiz-domanda { border: 0; padding: 0; margin: 0; }
  .quiz-domanda legend { padding: 0; margin-bottom: 1.25rem; }
  .quiz-n { font-size: .72rem; letter-spacing: .12em; color: var(--fg-2); margin-right: .35rem; vertical-align: middle; }
  .quiz-scelte { display: grid; gap: .5rem; }
  .quiz-scelta { text-align: left; padding: .95rem 1.1rem; border-radius: 14px; border: 1px solid var(--linea); background: var(--carta); transition: border-color .4s var(--respiro), background-color .4s var(--respiro); min-height: 44px; }
  .quiz-scelta:hover { border-color: var(--inchiostro); }
  .quiz-scelta:active { background: var(--carta-2); }
  .quiz-esito { display: grid; gap: 1rem; }
  .quiz-barre { display: grid; gap: .65rem; }
  .quiz-barre li { display: grid; grid-template-columns: 7rem 1fr; align-items: center; gap: 1rem; font-size: .8rem; }
  .quiz-bar { height: 8px; border-radius: 8px; background: var(--linea); overflow: hidden; }
  .quiz-bar span { display: block; height: 100%; background: var(--c, var(--inchiostro)); border-radius: 8px; transform-origin: left; transform: scaleX(0); transition: transform 1s var(--respiro); }
  .quiz-bar span.top { box-shadow: 0 0 0 2px color-mix(in srgb, var(--c) 30%, transparent); }
  .quiz-barre li span.mono { color: var(--c); font-weight: 600; }
  .quiz-azioni { display: flex; gap: .75rem; flex-wrap: wrap; margin-top: .5rem; }
  @media (max-width: 860px) { .quiz-grid { grid-template-columns: 1fr; gap: 0; } }

  /* ---------- SUL CAMPO ---------- */
  .galleria { display: grid; grid-template-columns: 1fr 1.4fr 1.4fr; grid-template-rows: auto auto; gap: 1rem; }
  .galleria :global(.g1) { grid-row: span 2; }
  .galleria :global(.g4) { grid-column: span 2; aspect-ratio: 21 / 9; }
  @media (max-width: 860px) {
    .galleria { grid-template-columns: 1fr; }
    .galleria :global(.g1) { grid-row: auto; }
    .galleria :global(.g4) { grid-column: auto; aspect-ratio: 3 / 2; }
  }

  /* ---------- MEDIA ---------- */
  .media-scheda { display: grid; gap: .75rem; height: 100%; text-decoration: none; position: relative; transition: border-color .5s var(--respiro), transform .6s var(--respiro); }
  .media-scheda:hover { border-color: var(--inchiostro); transform: translateY(-3px); }
  .media-tipo { font-size: .7rem; letter-spacing: .12em; text-transform: uppercase; }
  .media-freccia { position: absolute; right: 1.5rem; top: 1.4rem; }

  /* ---------- FAQ ---------- */
  .faq-grid { display: grid; grid-template-columns: 1fr 1.4fr; gap: 3rem; }
  .faq { border-top: 1px solid var(--linea); }
  .faq-voce { border-bottom: 1px solid var(--linea); }
  .faq-voce summary { list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: 1.35rem 0; cursor: pointer; font-family: var(--f-display); font-weight: 600; font-size: clamp(1.05rem, 1rem + .3vw, 1.25rem); letter-spacing: -0.015em; }
  .faq-voce summary::-webkit-details-marker { display: none; }
  .faq-segno { width: 14px; height: 14px; position: relative; flex: none; }
  .faq-segno::before, .faq-segno::after { content: ''; position: absolute; left: 0; right: 0; top: 50%; height: 1.5px; background: currentColor; transition: transform .5s var(--respiro); }
  .faq-segno::after { transform: rotate(90deg); }
  .faq-voce[open] .faq-segno::after { transform: rotate(0deg); }
  .faq-voce p { padding-bottom: 1.4rem; max-width: 58ch; }
  @media (max-width: 860px) { .faq-grid { grid-template-columns: 1fr; gap: 0; } }

  /* ---------- CHIUSURA ---------- */
  .chiusura { min-height: 90svh; display: grid; align-content: center; }
  .chiusura-grid { display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: 2rem; }
  .chiusura-ancora { aspect-ratio: 1; width: min(100%, 460px); justify-self: center; }
  .chiusura-testo { display: grid; gap: 1.5rem; justify-items: start; }
  .chiusura h2 { font-size: clamp(3rem, 2rem + 6vw, 7rem); }
  @media (max-width: 820px) {
    .chiusura-grid { grid-template-columns: 1fr; }
    .chiusura-ancora { width: min(70vw, 320px); }
  }

  /* ---------- PC: ogni sezione entra nello schermo ---------- */
  @media (min-width: 1024px) {
    .hero { padding-top: max(6rem, 13vh); padding-bottom: 5vh; min-height: 100svh; display: grid; align-content: center; }
    .hero-testo { gap: clamp(.7rem, 1.8vh, 1.2rem); }
    .fiducia { display: none; }
    .hero-foto { width: min(440px, 58vh); }
    .piani-pill { margin-top: -.2rem; }

    .mente { min-height: 100svh; display: grid; align-content: center; }
    .mente-ancora { width: min(520px, 45vh); }
    .mente-legenda { gap: clamp(.6rem, 2vh, 1.4rem); }
    .legenda { gap: 0; }
    .legenda li { padding: clamp(.35rem, 1.1vh, .7rem) 0; }
    .mente-sintesi { font-size: min(clamp(1.2rem, 1rem + .8vw, 1.6rem), 3.2vh); }
    .tel-svg { height: min(70px, 7vh); }
    .mente-stage { gap: clamp(1rem, 2.4vh, 1.75rem); }
    .mente-grid { row-gap: clamp(1.25rem, 3vh, 2.25rem); }

    .porta { min-height: min(13rem, 23vh); gap: 1rem; }

    .respiro { min-height: 100svh; display: grid; align-content: center; }
    .respiro-stage { width: min(520px, 60vh); }

    .cruscotto { min-height: 100svh; display: grid; align-content: center; }

    .campo-sezione .sezione-head { max-width: none; grid-template-columns: 1fr 1fr; align-items: end; column-gap: 3rem; }
    .campo-sezione .sezione-head .eyebrow { grid-column: 1 / -1; }
    .galleria { grid-template-columns: repeat(4, 1fr); grid-template-rows: none; grid-auto-rows: min(440px, 50vh); }
    .galleria :global(.foto-guida) { aspect-ratio: auto !important; height: 100%; grid-row: auto !important; grid-column: auto !important; }

    .chiusura { min-height: auto; }
    .chiusura-ancora { width: min(460px, 52vh); }
  }

  /* ---------- Guide animate: far capire subito cosa fare ---------- */
  .evidenziatore { background: linear-gradient(transparent 58%, rgba(36, 67, 214, .22) 58%) no-repeat 0 0 / 0% 100%; transition: background-size 1.1s var(--uscita) .3s; }
  .e2 { transition-delay: 1.1s; }
  .mente.vista .evidenziatore { background-size: 100% 100%; }

  .gesto { position: absolute; left: 50%; top: 50%; width: 0; height: 0; z-index: 3; pointer-events: none; transition: opacity .6s var(--respiro); }
  .mente.provato .gesto { opacity: 0; }
  .gesto-cursore { position: absolute; left: -12px; top: -12px; width: 28px; height: 28px; max-width: none; fill: var(--inchiostro); stroke: #fff; stroke-width: 1.5; filter: drop-shadow(0 4px 8px rgba(11, 18, 48, .3)); animation: gesto-muovi 4.2s var(--respiro) infinite; }
  .gesto-scia { position: absolute; left: -70px; top: 2px; width: 140px; height: 3px; border-radius: 3px; background: linear-gradient(90deg, transparent, rgba(36, 67, 214, .55), transparent); animation: gesto-scia 4.2s linear infinite; }
  .gesto-anello { position: absolute; left: -22px; top: -22px; width: 44px; height: 44px; border-radius: 50%; border: 2px solid var(--terracotta); opacity: 0; animation: gesto-anello 4.2s var(--uscita) infinite; }
  .gesto-label { position: absolute; left: 50%; top: 34px; transform: translateX(-50%); white-space: nowrap; font-family: var(--f-display); font-weight: 700; font-size: .9rem; }
  .gesto-label span { position: absolute; left: 50%; transform: translateX(-50%); padding: .35rem .75rem; border-radius: 999px; background: var(--inchiostro); color: #fff; box-shadow: 0 10px 24px -12px rgba(11, 18, 48, .6); }
  .gesto-label .l1 { animation: gesto-l1 4.2s steps(1) infinite; }
  .gesto-label .l2 { background: var(--terracotta); animation: gesto-l2 4.2s steps(1) infinite; }
  @keyframes gesto-muovi {
    0% { transform: translate(-90px, 0); } 8% { transform: translate(90px, -14px); } 16% { transform: translate(-90px, 10px); }
    24% { transform: translate(90px, -8px); } 32% { transform: translate(-90px, 6px); } 40% { transform: translate(60px, 0); }
    50%, 100% { transform: translate(0, 0); }
  }
  @keyframes gesto-scia { 0%, 40% { opacity: 1; transform: scaleX(1); } 48%, 100% { opacity: 0; transform: scaleX(.2); } }
  @keyframes gesto-anello { 0%, 52% { opacity: 0; transform: scale(.6); } 60% { opacity: 1; transform: scale(1); } 85%, 100% { opacity: 0; transform: scale(1.8); } }
  @keyframes gesto-l1 { 0% { opacity: 1; } 48% { opacity: 0; } }
  @keyframes gesto-l2 { 0% { opacity: 0; } 48% { opacity: 1; } }
  @media (pointer: coarse) { .gesto { display: none; } }

  .tieni-dito { position: absolute; left: 1.1rem; top: 50%; width: 1.9rem; height: 1.9rem; margin-top: -.95rem; }
  .tieni-dito svg { width: 100%; height: 100%; fill: none; stroke: #fff; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; animation: dito-preme 1.8s var(--respiro) infinite; transform-origin: 50% 80%; }
  @keyframes dito-preme { 0%, 100% { transform: translateY(0) scale(1); } 40%, 60% { transform: translateY(3px) scale(.88); } }
  .tieni::after { content: ''; position: absolute; inset: -4px; border-radius: 999px; border: 2px solid var(--terracotta); animation: tieni-onda 1.8s var(--uscita) infinite; pointer-events: none; }
  @keyframes tieni-onda { 0% { opacity: .9; transform: scale(1); } 100% { opacity: 0; transform: scale(1.12, 1.35); } }
  .tieni { overflow: visible; isolation: isolate; }
  .tieni-riempi { border-radius: 999px; overflow: hidden; }
  .tieni.usato::after, .tieni.premuto::after, .tieni.usato .tieni-dito svg { animation: none; opacity: 0; }
  .tieni.usato .tieni-dito svg { opacity: 1; }
  @media (prefers-reduced-motion: reduce) { .gesto-cursore, .gesto-scia, .gesto-anello, .tieni::after, .tieni-dito svg { animation: none; } .gesto-label .l2 { display: none; } }
  /* ---------- MOBILE: ogni sezione in una schermata ---------- */
  .scorri { display: none; }
  @media (max-width: 860px) {
    .scorri { display: inline-flex; align-items: center; gap: .4rem; font-size: .7rem; letter-spacing: .14em; text-transform: uppercase; color: var(--fg-2); }
    .scorri span { display: inline-block; animation: scorri 1.6s var(--respiro) infinite; }
    @keyframes scorri { 0%, 100% { transform: translateX(0); } 50% { transform: translateX(6px); } }
    .carosello, .galleria, .media-sezione .griglia-3, .pista-binario {
      display: flex; gap: .75rem; overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x mandatory;
      margin-inline: calc(-1 * var(--gutter)); padding: .25rem var(--gutter) .5rem; scroll-padding-inline: var(--gutter); scrollbar-width: none;
    }
    .galleria::-webkit-scrollbar, .media-sezione .griglia-3::-webkit-scrollbar, .pista-binario::-webkit-scrollbar { display: none; }

    /* le sezioni a griglia non devono allargarsi per colpa delle schede che scorrono */
    .sezione { grid-template-columns: minmax(0, 1fr); }
    .pista-stage { overflow: hidden; }

    /* Hero */
    .hero { min-height: 100svh; padding-top: 4.6rem; padding-bottom: 1rem; display: grid; align-content: center; }
    .hero-grid { gap: 1.4rem; }
    .hero-testo { gap: .95rem; }
    .hero-foto { width: min(76vw, 44svh); padding: .3rem; }
    .hero h1 { font-size: clamp(2.2rem, 10.5vw, 3rem); max-width: none; }
    .hero .lead { font-size: 1rem; }
    .pill { font-size: .78rem; padding: .32rem .65rem; }
    .piani-pill { gap: .35rem; margin-top: -.2rem; }
    .hero-cta .btn { min-height: 3rem; padding-inline: 1rem; }
    .fiducia, .solo-desk, .solo-desk-flex { display: none !important; }
    .hero-ruolo { font-size: .66rem; }
    .hero-chi { gap: .15rem; }
    .piani-pill { flex-wrap: nowrap; }
    .pill { font-size: .72rem; padding: .28rem .5rem; gap: .35rem; }
    .pill-punto { width: 6px; height: 6px; }
    :global(.hero-cred) { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: .45rem; order: 1; }
    .hero-cta { order: 2; padding-right: 4.6rem; }
    :global(.hero-cred .cred-val) { white-space: nowrap; }
    :global(.hero-cred li:last-child .cred-val) { white-space: normal; line-height: 1.15; }
    :global(.hero-cred .credenziale) { height: 100%; padding: .45rem .55rem; gap: .45rem; border-radius: 12px; }
    :global(.hero-cred .mindup-logo) { height: 1.75rem; padding-right: .45rem; }
    :global(.hero-cred .mindup-segnaposto) { font-size: .82rem; }
    :global(.hero-cred .cred-val) { font-size: .76rem; }
    :global(.hero-cred .cred-lab) { font-size: .52rem; }

    /* La sfera */
    .mente { min-height: 100svh; display: grid; align-content: center; }
    .mente-grid { gap: 1.6rem; }
    .mente-testo { gap: .8rem; }
    .mente-testo .lead { font-size: 1rem; }
    .mente-legenda { display: none; }
    .mente-stage { gap: 1.25rem; }
    .mente-ancora { width: min(88vw, 40svh); }
    .angolo { font-size: .74rem; padding: .22rem .55rem; }
    .a1, .a2 { top: -2%; } .a3, .a4 { bottom: -2%; }
    .a1, .a3 { left: -9%; } .a2, .a4 { right: -9%; }
    .tieni { min-height: 3.5rem; padding-block: .5rem; }
    .tieni-testo { font-size: 1rem; }
    .tel-testa { display: none; }
    .tel-svg { display: none; }
    .tel-msg { margin-top: .2rem; font-size: .72rem; }

    /* Porte */
    .porte-sezione { min-height: 100svh; display: grid; align-content: center; }
    .porta { padding: .7rem .9rem; gap: .8rem; }
    .porta-icona { width: 2.2rem; height: 2.2rem; border-radius: 10px; }
    .porta-nome { font-size: 1.12rem; }
    .porta-esito { margin-top: .75rem; padding: .9rem 1rem; }

    /* Respiro */
    .respiro { min-height: 100svh; display: grid; align-content: center; }
    .respiro-grid { gap: 1.25rem; }
    .respiro-testo { gap: .8rem; }
    .respiro-stage { width: min(68vw, 34svh); }

    /* Cruscotto */
    .cruscotto { min-height: 100svh; display: grid; align-content: center; }
    .cruscotto-layout { gap: .6rem; }
    .cruscotto-head { margin-bottom: .25rem; }
    .cruscotto-grid { grid-template-columns: 1fr 1fr; grid-template-areas: 's1 s2' 's3 s4'; gap: .7rem; }
    .cruscotto-ancora { display: none; }
    
    .strumento { padding: .9rem .6rem .75rem; gap: .3rem; border-radius: 16px; }
    .strumento svg { max-width: 110px !important; }
    .strumento-nome { font-size: 1rem; }
    .strumento-nome::before { width: 6px; height: 6px; margin-right: .25rem; }
    .strumento-val { font-size: .66rem; }
