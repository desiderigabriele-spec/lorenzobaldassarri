---
import Base from '../layouts/Base.astro';
import { porte, piani, contatti, identita } from '../data/sito.js';
import FotoGuida from '../components/FotoGuida.astro';
import Credenziali from '../components/Credenziali.astro';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': 'https://www.lorenzobaldassarri.it/#persona',
      name: 'Lorenzo Baldassarri',
      honorificPrefix: 'Dott.',
      image: 'https://www.lorenzobaldassarri.it/img/lorenzo-studio.jpg',
      jobTitle: ['Psicologo esperto di performance', 'Psicologo-Psicoterapeuta', 'Psicologo dello sport', 'Co-founder di MindUP Enhancement Psychology®'],
      worksFor: { '@type': 'Organization', name: 'MindUP Enhancement Psychology®', url: 'https://www.mindup.live/' },
      disambiguatingDescription: 'Psicologo e psicoterapeuta di Montecatini Terme; non il pilota motociclistico omonimo.',
      alumniOf: [
        { '@type': 'CollegeOrUniversity', name: 'Università degli Studi di Firenze' },
        { '@type': 'CollegeOrUniversity', name: 'Università degli Studi di Urbino Carlo Bo' },
      ],
      memberOf: { '@type': 'Organization', name: 'Ordine degli Psicologi della Toscana' },
      affiliation: { '@type': 'CollegeOrUniversity', name: 'Università degli Studi di Parma' },
      knowsAbout: ['Psicologia del Potenziamento', 'Psicologia della performance', 'Psicologia dello sport', 'Psicoterapia funzionale', 'Mental training', 'Gestione dello stress', 'Ansia da prestazione'],
      sameAs: [
        'https://www.linkedin.com/in/lorenzo-baldassarri-70b39343/',
        'https://www.mindup.live/',
        'https://www.eljos.it/dott-lorenzo-baldassarri/',
      ],
    },
    {
      '@type': 'ProfessionalService',
      name: 'Studio del Dott. Lorenzo Baldassarri — Psicologo e Psicoterapeuta',
      address: { '@type': 'PostalAddress', streetAddress: contatti.indirizzo, postalCode: '51016', addressLocality: 'Montecatini Terme', addressRegion: 'PT', addressCountry: 'IT' },
      founder: { '@id': 'https://www.lorenzobaldassarri.it/#persona' },
      logo: 'https://www.lorenzobaldassarri.it/logo/01-monogramma-completo-blu-notte.svg',
      areaServed: 'IT',
    },
  ],
};

const icone = {
  atleti: 'M12 3l2.4 5 5.6.8-4 3.9.9 5.5L12 15.6 7.1 18.2l.9-5.5-4-3.9 5.6-.8z',
  squadre: 'M8 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6zm8 0a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM2 20c0-3.3 2.7-6 6-6s6 2.7 6 6m-2.4-5.6A6 6 0 0 1 22 20',
  aziende: 'M4 8h16v11H4zM9 8V5h6v3M4 13h16',
  motorsport: 'M5 21V4m0 1h11l-2 3.5L16 12H5',
  psicoterapia: 'M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z',
};
const autorita = ['Formula Medicine 2013–16', 'Academy toscana F.I.R.', 'Università di Parma', 'KM2025 · Università di Siena', 'Radio Bianconera', 'RTV38', 'Scienza & Sport'];

const numeri = [
  { to: 15, suffix: '+', label: 'anni di studio clinico' },
  { to: 4, suffix: '', label: 'piani misurati, insieme' },
  { to: 20, suffix: '+', label: 'anni nel calcio, prima della psicologia' },
  { to: 3, suffix: '', label: 'anni nel paddock con Formula Medicine' },
];

const tappe = [
  { n: '01', quando: 'Campo', titolo: 'Il campo, prima di tutto.', testo: "Oltre vent'anni da calciatore. Poi allenatore nella Scuola Calcio della mia città." },
  { n: '02', quando: 'Persona', titolo: 'Crescere la persona, non solo il gesto.', testo: 'Responsabile educativo da psicologo. Un progetto di inclusione presentato a Pistoia.' },
  { n: '03', quando: '2011', titolo: 'Lo studio.', testo: 'Psicologo e psicoterapeuta a Montecatini Terme. Ansia, stress, prestazione.' },
  { n: '04', quando: '2013–2016', titolo: 'Il paddock.', testo: 'Area mental di Formula Medicine: piloti di F1 e DTM, Serie A, olimpionici.' },
  { n: '05', quando: '2017', titolo: 'Il metodo prende forma.', testo: "Co-fondo il Gruppo Eljos. Docente all'Università di Parma." },
  { n: '06', quando: '2021 → oggi', titolo: 'Ovunque si giochi sotto pressione.', testo: "MindUP, l'academy toscana di rugby, le aziende. Lo stesso metodo." },
];

const giri = [
  { giro: 'Giro 1', titolo: 'Conoscersi', testo: 'Un primo colloquio. Ti ascolto e capisco il contesto.' },
  { giro: 'Giro 2', titolo: 'Misurare', testo: 'Valutazione sui quattro piani, con dati dove servono.' },
  { giro: 'Giro 3', titolo: 'Allenare', testo: 'Un piano su misura, in seduta e sul campo.' },
  { giro: 'Giro 4', titolo: 'Verificare', testo: 'Misuriamo i progressi. Si corregge la traiettoria.' },
];

const domande = [
  {
    q: 'Quando sale la pressione, cosa cambia per primo?',
    r: ['I pensieri corrono', 'Sale la paura di sbagliare', 'I muscoli si irrigidiscono', 'Il cuore accelera'],
  },
  {
    q: 'Dopo un errore, cosa ti trattiene?',
    r: ['Ci ripenso di continuo', 'Rabbia o sconforto', 'Il gesto si blocca', 'Mi manca il fiato'],
  },
  {
    q: 'La notte prima di un momento importante…',
    r: ['La testa non si spegne', 'Sono agitato', 'Il corpo non si rilassa', 'Dormo male, battito veloce'],
  },
  {
    q: 'Nel momento decisivo ti capita di…',
    r: ['Pensare troppo', 'Avere paura del risultato', 'Contrarre il movimento', 'Respirare corto'],
  },
  {
    q: 'Cosa ti piacerebbe allenare?',
    r: ['Concentrazione', 'Gestione delle emozioni', 'Scioltezza', 'Recupero ed energia'],
  },
];

const faq = [
  { q: 'Psicologo dello sport o mental coach?', a: "Lo psicologo dello sport è un professionista sanitario iscritto all'Albo, con formazione clinica. Il titolo di mental coach non è regolamentato. Lavoro sulla prestazione con gli strumenti e le tutele della psicologia." },
  { q: 'È solo per professionisti?', a: 'No. Lavoro con atleti di ogni livello, ragazzi, famiglie, manager. La pressione non guarda la categoria.' },
  { q: 'Lavori con i minorenni?', a: 'Sì, sempre con il consenso dei genitori, che coinvolgo nel percorso. Nessun dato o immagine dei ragazzi viene reso pubblico.' },
  { q: 'Quanto dura un percorso?', a: "Dipende dall'obiettivo. Dopo il primo colloquio e la valutazione ti propongo un piano chiaro, con tempi e verifiche." },
  { q: 'Performance o psicoterapia: che differenza c’è?', a: 'Il percorso di performance allena risorse verso un obiettivo. La psicoterapia cura una sofferenza. Se serve, lo valutiamo insieme dal primo colloquio.' },
];

const media = [
  { tipo: 'Convegno · 2025', titolo: 'KM2025, Industry Day', testo: 'Invited talk sul metodo, Università di Siena.', href: 'https://www.iiakm.org/conference/KM2025/pdfs/KM2025_Industry-Day-Invited-Talk_BALDASSARRI.pdf' },
  { tipo: 'TV · RTV38', titolo: 'Salute e prestazione', testo: 'Ospite del programma Tada con Riccardo Paterni.', href: 'https://www.mindup.live/en/blog/67/lorenzo-baldassarri-and-riccardo-paterni-talk-about-health-and-performance-in-the-rtv38-s-tada--television-program' },
  { tipo: 'Articolo · TagMedicina', titolo: 'Sport, relax, ansia e stress', testo: 'Perché il movimento è anche un allenamento mentale.', href: 'https://www.tagmedicina.it/2022/02/05/lo-sport-relax-ansia-stress/' },
];
---
<Base
  title="Lorenzo Baldassarri – Psicologo dello sport e Psicoterapeuta"
  description="Lorenzo Baldassarri, psicologo e psicoterapeuta a Montecatini Terme. Alleno ciò che decide la prestazione sotto pressione: pensieri, emozioni, corpo, fisiologia. Atleti, squadre, aziende, motorsport."
  jsonLd={jsonLd}
>
  <canvas class="tela-3d" aria-hidden="true"></canvas>

  <!-- 1 · HERO: la persona -->
  <section class="sezione hero" data-theme="carta" aria-labelledby="hero-titolo">
    <div class="wrap hero-grid">
      <div class="hero-testo">
        <p class="hero-ruolo mono" data-reveal>{identita.ruolo}<span class="solo-desk"> · Psicoterapeuta</span></p>
        <h1 id="hero-titolo" data-reveal style="--d:.08s">Sotto pressione, <span class="a-capo">la mente <span class="evidenza">si allena.</span></span></h1>
        <p class="lead" data-reveal style="--d:.16s">Alleno i quattro piani che decidono la prestazione:</p>
        <ul class="piani-pill" role="list" data-reveal style="--d:.2s">
          {piani.map((p) => <li class={`pill p-${p.id}`}><span class="pill-punto"></span>{p.nome}</li>)}
        </ul>
        <div class="hero-cta" data-reveal style="--d:.24s">
          <a class="btn btn-primario" href="/contatti" data-cta>Prenota una call</a>
          <a class="btn btn-secondario solo-desk-flex" href="#mente">Mettiti alla prova <span class="freccia" aria-hidden="true">↓</span></a>
        </div>
        <Credenziali classe="hero-cred" />
        <p class="fiducia mono" data-reveal style="--d:.32s">Albo Psicologi Toscana n. {contatti.albo} · Docente Università di Parma</p>
      </div>
      <div class="hero-foto" data-reveal style="--d:.12s">
        <div class="aurora" aria-hidden="true"><span class="b1"></span><span class="b2"></span><span class="b3"></span><span class="b4"></span></div>
        <FotoGuida tipo="ritratto" src={contatti.foto} alt="Il Dott. Lorenzo Baldassarri nel suo studio di Montecatini Terme" classe="foto-hero" fuoco="50% 22%" eager guida={['Verticale 4:5, mezzo busto', 'Sguardo verso sinistra (verso il titolo)', 'Luce laterale morbida, sfondo neutro']} />
        <span class="badge badge-1"><span class="mono">dal 2011</span> Psicologo · Psicoterapeuta</span>
        <span class="badge badge-2"><span class="mono">Creatore</span> Psicologia del Potenziamento®</span>
        <span class="badge badge-3"><span class="mono">2013–16</span> Formula Medicine</span>
      </div>
    </div>
  </section>

  <!-- 2 · LA SFERA: la tua mente sotto pressione -->
  <section class="sezione mente" id="mente" data-theme="carta" data-stato="mente" aria-labelledby="mente-titolo">
    <div class="wrap mente-grid">
      <div class="mente-testo">
        <p class="eyebrow" data-reveal>Prova adesso</p>
        <h2 id="mente-titolo" data-reveal>La tua mente, sotto pressione.</h2>
        <p class="lead" data-reveal>Questa sfera sei tu. Ogni colore è un piano. <strong class="hint-fine evidenziatore">Muovi il cursore veloce</strong><strong class="hint-touch evidenziatore">Tieni premuto il pulsante</strong>: i piani si separano. <strong class="hint-fine evidenziatore e2">Fermati</strong><strong class="hint-touch evidenziatore e2">Lascia</strong>: tornano insieme.</p>
        <button type="button" class="come-si-usa" data-guida="mente"><span aria-hidden="true">?</span> Come si usa</button>
      </div>
      <div class="mente-stage">
        <div class="mente-ancora" data-ancora>
          <div class="gesto" aria-hidden="true">
            <svg class="gesto-cursore" viewBox="0 0 24 24"><path d="M4 2l16 9.5-7 1.6L9.6 20z" /></svg>
            <span class="gesto-scia"></span>
            <span class="gesto-anello"></span>
            <span class="gesto-label"><span class="l1">Muovi veloce</span><span class="l2">Ora fermati</span></span>
          </div>
          {piani.map((p, i) => <span class={`angolo a${i + 1} p-${p.id}`} aria-hidden="true">{p.nome}</span>)}
        </div>
        <button type="button" class="tieni" data-tieni aria-describedby="mente-titolo">
          <span class="tieni-riempi" aria-hidden="true"></span>
          <span class="tieni-dito" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M9 11V5.5a1.5 1.5 0 0 1 3 0V10m0-.5V8a1.5 1.5 0 0 1 3 0v2m0-.5a1.5 1.5 0 0 1 3 0V15a6 6 0 0 1-6 6h-1a6 6 0 0 1-4.7-2.3L4 15.5a1.6 1.6 0 0 1 2.4-2.1L9 15" /></svg></span>
          <span class="tieni-testo">Tieni premuto</span>
        </button>
        <div class="pressometro" aria-hidden="true">
          <span class="mono">Pressione</span>
          <span class="pressometro-barra"><span data-pressione-barra></span></span>
          <span class="mono pressometro-val" data-pressione-val>0%</span>
        </div>
        <div class="telemetria">
          <div class="tel-testa mono">
            <span class="tel-live"><span class="tel-punto"></span> Battito · esempio</span>
            <span><span class="tel-bpm" data-bpm>62</span> bpm</span>
          </div>
          <svg class="tel-svg" viewBox="0 0 1000 120" preserveAspectRatio="none" role="img" aria-label="Linea del battito illustrativa: si agita quando ti muovi in fretta, si calma quando ti fermi.">
            <line x1="0" y1="60" x2="1000" y2="60" class="tel-asse" />
            <path class="tel-linea" d="M0 60 L1000 60" />
          </svg>
          <p class="tel-msg mono" aria-live="polite"><span class="hint-fine">In attesa: muoviti, poi fermati.</span><span class="hint-touch">In attesa: tieni premuto, poi lascia.</span></p>
        </div>
      </div>
      <div class="mente-legenda">
        <ol class="legenda" role="list">
          {piani.map((p, i) => (
            <li class={`p-${p.id}`} data-reveal style={`--d:${i * 0.06}s`}>
              <span class="legenda-punto"></span>
              <span><strong>{p.nome}</strong> <span class="muted">{p.esempio}</span></span>
            </li>
          ))}
        </ol>
        <p class="mente-sintesi" data-reveal>Il mio lavoro è tenerli insieme, <span class="evidenza">anche quando la pressione sale.</span></p>
      </div>
    </div>
  </section>


  <!-- 3 · AUTORITÀ + NUMERI -->
  <section class="sezione autorita-sezione" data-theme="carta" aria-label="Esperienze e numeri">
    <div class="nastro" aria-hidden="true">
      <div class="nastro-scorre mono">
        {[...autorita, ...autorita].map((a) => <span>{a}</span>)}
      </div>
    </div>
    <ul class="sr-only" role="list">{autorita.map((a) => <li>{a}</li>)}</ul>
    <div class="wrap">
      <ul class="numeri" role="list">
        {numeri.map((n, i) => (
          <li class="numero" data-reveal style={`--d:${i * 0.08}s`}>
            <span class="numero-val display"><span data-conta={n.to}>{n.to}</span>{n.suffix}</span>
            <span class="numero-lab">{n.label}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 4 · RESPIRA CON ME -->
  <section class="sezione respiro" id="respiro" data-theme="carta" data-stato="respiro" aria-labelledby="respiro-titolo">
    <div class="wrap respiro-grid">
      <div class="respiro-testo">
        <p class="eyebrow" data-reveal>Piano fisiologico</p>
        <h2 id="respiro-titolo" data-reveal>Trenta secondi. Prova.</h2>
        <p class="lead" data-reveal>Inspira per 4, espira per 6. Il respiro lungo rallenta il battito: è il primo strumento che si allena.</p>
        <div class="respiro-azioni" data-reveal>
          <button class="btn btn-primario" type="button" data-respiro-start>Inizia <span class="mono" style="opacity:.8">30 s</span></button>
          <button class="btn btn-secondario" type="button" data-respiro-stop hidden>Interrompi</button>
        </div>
        <div class="respiro-fine" hidden>
          <p class="h3">Hai appena allenato il piano fisiologico.</p>
          <a class="link-freccia" href="#cruscotto">Scopri gli altri tre <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <div class="respiro-stage" data-ancora>
        <svg class="respiro-anello" viewBox="0 0 200 200" aria-hidden="true">
          <circle cx="100" cy="100" r="96" class="anello-guida" />
          <circle cx="100" cy="100" r="96" class="anello-progresso" pathLength="1" />
        </svg>
        <div class="respiro-centro">
          <p class="respiro-fase display" aria-live="assertive">Pronto?</p>
          <p class="respiro-conto mono" data-respiro-conto>30</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 5 · IL CRUSCOTTO -->
  <section class="sezione cruscotto" id="cruscotto" data-theme="cruscotto" data-stato="cruscotto" aria-labelledby="cruscotto-titolo">
    <div class="wrap cruscotto-layout">
      <div class="sezione-head cruscotto-head">
        <p class="eyebrow" data-reveal>Il metodo · quattro piani</p>
        <h2 id="cruscotto-titolo" data-reveal>Non basta pensare positivo.</h2>
        <p class="lead" data-reveal>Tocca un piano e spostalo. Al centro è verde: equilibrio. Se lo porti troppo in là va in rosso, e trascina con sé anche gli altri.</p>
        <button type="button" class="come-si-usa" data-guida="cruscotto"><span aria-hidden="true">?</span> Come si usa</button>
      </div>

      <div class="cruscotto-grid">
        {piani.map((p, i) => (
          <button class={`strumento s${i + 1} p-${p.id}`} type="button" data-strumento={p.id} aria-pressed={i === 0 ? 'true' : 'false'} aria-controls="pressione">
            <svg viewBox="0 0 120 72" aria-hidden="true">
              <path class="arco-base" d="M12 62 A48 48 0 0 1 108 62" />
              <path class="arco-zone" d="M12 62 A48 48 0 0 1 108 62" />
              <line class="lancetta" x1="60" y1="62" x2="60" y2="22" />
              <circle cx="60" cy="62" r="3.5" class="perno" />
            </svg>
            <span class="strumento-nome">{p.nome}</span>
            <span class="strumento-val mono"><span data-val>—</span></span>
          </button>
        ))}
        <div class="cruscotto-ancora" data-ancora aria-hidden="true"></div>
      </div>
      <svg class="defs-cruscotto" width="0" height="0" aria-hidden="true" focusable="false">
        <defs>
          <linearGradient id="zone-equilibrio" gradientUnits="userSpaceOnUse" x1="12" y1="0" x2="108" y2="0">
            <stop offset="0" stop-color="#FF5A5F" /><stop offset=".28" stop-color="#FFB547" /><stop offset=".5" stop-color="#2EE6C0" /><stop offset=".72" stop-color="#FFB547" /><stop offset="1" stop-color="#FF5A5F" />
          </linearGradient>
        </defs>
      </svg>

      <div class="pressione">
        <label for="pressione" class="mono pressione-lab">Stai regolando: <span data-piano-scelto>Pensiero</span></label>
        <input id="pressione" type="range" min="0" max="100" value="50" step="1" aria-valuetext="Pensiero in equilibrio" />
        <output class="mono pressione-out" for="pressione">In equilibrio</output>
        <button type="button" class="pressione-reset mono" data-equilibrio>Riporta tutto al centro</button>
      </div>

      <p id="cruscotto-dettaglio" class="cruscotto-dettaglio" aria-live="polite">Tutto verde: i quattro piani lavorano insieme.</p>
      <div class="cruscotto-chiusa">
        <p class="h3" data-reveal>Il pensiero positivo muove una lancetta.<br /><span class="accento">Io alleno tutte e quattro.</span></p>
        <a class="link-freccia" href="/metodo">Il metodo in dettaglio <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <!-- 6 · DALLA SCUOLA CALCIO ALLA FORMULA 1 -->
  <section class="sezione pista" data-theme="cruscotto" data-stato="pista" aria-labelledby="pista-titolo">
    <div class="pista-ancora" data-ancora aria-hidden="true"></div>
    <div class="stage pista-stage">
      <div class="wrap pista-head">
        <p class="eyebrow">La storia</p>
        <h2 id="pista-titolo">Dalla Scuola Calcio<br />alla Formula 1.</h2>
        <div class="pista-progresso mono" aria-hidden="true"><span data-tappa>01</span> / 06 <span class="barra"><span></span></span> <span class="scorri">Scorri <span>→</span></span></div>
      </div>
      <div class="pista-binario">
        <ol class="pista-tappe" role="list">
          {tappe.map((t) => (
            <li class="tappa">
              <p class="tappa-quando mono">{t.n} · {t.quando}</p>
              <h3>{t.titolo}</h3>
              <p class="muted">{t.testo}</p>
            </li>
          ))}
        </ol>
        <svg class="pista-traccia" viewBox="0 0 1000 100" preserveAspectRatio="none" aria-hidden="true">
          <path class="traccia-base" d="M0 70 L330 70 C 420 70 440 22 540 22 S 690 88 790 74 S 930 24 1000 40" />
          <path class="traccia-viva" d="M0 70 L330 70 C 420 70 440 22 540 22 S 690 88 790 74 S 930 24 1000 40" pathLength="1" />
        </svg>
      </div>
    </div>
  </section>

  <!-- 7 · COME LAVORO -->
  <section class="sezione giri-sezione" data-theme="carta" aria-labelledby="giri-titolo">
    <div class="wrap">
      <div class="sezione-head">
        <p class="eyebrow" data-reveal>Come lavoro</p>
        <h2 id="giri-titolo" data-reveal>Prima ti ascolto. Poi misuro. Poi alleniamo.</h2>
      </div>
      <ol class="giri" role="list">
        {giri.map((g, i) => (
          <li class="giro" data-reveal style={`--d:${i * 0.08}s`}>
            <span class="giro-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <div class="giro-testo">
              <h3>{g.titolo}</h3>
              <p class="muted">{g.testo}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 8 · AUTOVALUTAZIONE -->
  <section class="sezione quiz-sezione" data-theme="carta" id="autovalutazione" aria-labelledby="quiz-titolo">
    <div class="wrap quiz-grid">
      <div class="sezione-head">
        <p class="eyebrow" data-reveal>Autovalutazione</p>
        <h2 id="quiz-titolo" data-reveal>Come ti cambia la pressione?</h2>
        <p class="lead" data-reveal>Cinque tocchi. Nessun dato personale. Non è un test diagnostico.</p>
      </div>
      <div class="quiz scheda" data-reveal>
        <div class="quiz-barra" aria-hidden="true"><span></span></div>
        {domande.map((d, i) => (
          <fieldset class="quiz-domanda" data-domanda={i} hidden={i !== 0}>
            <legend class="h3"><span class="mono quiz-n">{i + 1}/5</span> {d.q}</legend>
